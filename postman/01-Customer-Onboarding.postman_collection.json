                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set(\"manager2_access_token\", json.access_token);",
                  "    pm.environment.set(\"manager2_access_token\", json.access_token);",
                  "    console.log(\"manager2_access_token kaydedildi.\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "manager2@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "test",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid profile email roles offline_access api",
                  "type": "text"
                }
              ]
            },
            "url": "{{idpUrl}}/connect/token",
            "description": "`credit-allocation` akışındaki 4-Göz (`approve-stage2-four-eyes`, `denyRoles: [\"$previousUser\"]`) adımını farklı bir yönetici ile onaylamak için kullanılır. Otomatik olarak `{{manager2_access_token}}` değişkenine kaydedilir."
          }
        },
        {
          "name": "3. Token Al - Standart Kullanıcı (user@test.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token başarıyla alındı (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set(\"user_access_token\", json.access_token);",
                  "    pm.environment.set(\"user_access_token\", json.access_token);",
                  "    console.log(\"user_access_token kaydedildi.\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
