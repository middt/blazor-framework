            {
              "name": "4A. İletişim Bilgilerini Ekle (add)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP status 200\", function () {",
                      "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                      "});",
                      "if (pm.response.code === 200) {",
                      "    pm.test(\"billingContact\", function () {",
                      "        pm.expect(pm.response.json().data.data.billingContact).to.eql({\"email\": \"finans@anadolulojistik.com\", \"phone\": \"02124440123\", \"address\": \"Maslak Mah. Büyükdere Cad. No:1 Sarıyer/İstanbul\"});",
                      "    });",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
