    {
      "name": "02 - Risk & Limit Evaluation (Risk & Limit Değerlendirme)",
      "description": "Workflow Key: `risk-limit-eval`\n\nHem bağımsız olarak hem de `credit-allocation` (SubFlow) ve `order-payment-orchestration` (FanOut) içinden çağrılabilen alt-akış servisidir.\n\n### Senaryolar:\n- **Senaryo A (Otomatik Onay -> `approved`)**: `amount <= 500000` (veya `requireUnderwriting == false && amount <= 5000000`).\n- **Senaryo B (Manuel Underwriting -> `manual-underwriting`)**: `requireUnderwriting == true && amount > 500000`. Ardından `approve-underwriting` veya `reject-underwriting` çalıştırılır.\n- **Senaryo C (Otomatik Red -> `rejected`)**: `requireUnderwriting == false && amount > 5000000`.",
      "item": [
        {
          "name": "1. Tanımı Getir (GET /api/workflows/risk-limit-eval)",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval",
            "description": "`risk-limit-eval` iş akışı tanımını döner."
          }
        },
        {
          "name": "2A. Başlat - Senaryo A: Düşük Tutar <= 500.000 TL (Otomatik Onay -> approved)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "try {",
                  "    const json = pm.response.json();",
                  "    const val = json.data.id;",
                  "    if (val) {",
                  "        pm.collectionVariables.set(\"riskLimitInstanceId\", val);",
                  "        pm.environment.set(\"riskLimitInstanceId\", val);",
                  "        console.log(\"riskLimitInstanceId =\", val);",
                  "    }",
                  "} catch (e) {",
                  "    console.warn(\"Response parse warning:\", e);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances",
            "description": "Tutar <= 500.000 TL olduğu için `evaluate` adımından otomatik olarak `to-approved` geçişiyle `approved` durumuna tamamlanır (`riskGrade: \"A\"`, `approvedLimit: 300000`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"RISK-AUTO-{{$randomInt}}\",\n  \"data\": {\n    \"customerKey\": \"{{customerKey}}\",\n    \"amount\": 250000,\n    \"checkType\": \"KKB & Findeks Sorgusu\",\n    \"requireUnderwriting\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2B. Başlat - Senaryo B: Yüksek Tutar > 500.000 TL + Underwriting (manual-underwriting)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "try {",
                  "    const json = pm.response.json();",
                  "    const val = json.data.id;",
                  "    if (val) {",
                  "        pm.collectionVariables.set(\"riskLimitInstanceId\", val);",
                  "        pm.environment.set(\"riskLimitInstanceId\", val);",
                  "        console.log(\"riskLimitInstanceId =\", val);",
                  "    }",
                  "} catch (e) {",
                  "    console.warn(\"Response parse warning:\", e);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances",
            "description": "`requireUnderwriting: true` ve `amount > 500000` olduğu için `manual-underwriting` (Tahsis Uzmanı İncelemesi) durumunda bekler.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"RISK-UW-{{$randomInt}}\",\n  \"data\": {\n    \"customerKey\": \"{{customerKey}}\",\n    \"amount\": 1200000,\n    \"checkType\": \"Detaylı Kurumsal Risk Analizi\",\n    \"requireUnderwriting\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2C. Başlat - Senaryo C: Aşırı Tutar > 5.000.000 TL (Otomatik Red -> rejected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "try {",
                  "    const json = pm.response.json();",
                  "    const val = json.data.id;",
                  "    if (val) {",
                  "        pm.collectionVariables.set(\"riskLimitInstanceId\", val);",
                  "        pm.environment.set(\"riskLimitInstanceId\", val);",
                  "        console.log(\"riskLimitInstanceId =\", val);",
                  "    }",
                  "} catch (e) {",
                  "    console.warn(\"Response parse warning:\", e);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances",
            "description": "`amount > 5000000` ve `requireUnderwriting: false` olduğu için otomatik olarak `to-rejected` geçişiyle `rejected` durumuna düşer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"RISK-REJ-{{$randomInt}}\",\n  \"data\": {\n    \"customerKey\": \"{{customerKey}}\",\n    \"amount\": 7500000,\n    \"checkType\": \"Otomatik Limit Kontrolü\",\n    \"requireUnderwriting\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Akış Durumunu Sorgula (GET Instance)",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances/{{riskLimitInstanceId}}",
            "description": "`{{riskLimitInstanceId}}` örneğinin durumunu ve `availableTransitions` listesini döner."
          }
        },
        {
          "name": "4A. [manual-underwriting] Tahsis Uzmanı Onayı (approve-underwriting -> approved)",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances/{{riskLimitInstanceId}}/transitions/approve-underwriting",
            "description": "`manual-underwriting` durumundaki risk değerlendirmesini onaylar (`approved`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"underwriterNote\": \"Bilanço ve nakit akışı incelendi, %100 limit onayı uygun görüldü.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4B. [manual-underwriting] Tahsis Uzmanı Reddi (reject-underwriting -> rejected)",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances/{{riskLimitInstanceId}}/transitions/reject-underwriting",
            "description": "Alternatif: `manual-underwriting` durumundaki risk değerlendirmesini reddeder (`rejected`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Mevcut borçluluk oranı politika limitlerinin üzerinde.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. Geçmişi Listele (GET History)",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/risk-limit-eval/instances/{{riskLimitInstanceId}}/history",
            "description": "Risk değerlendirme akışının geçiş geçmişini döner."
          }
        }
      ]
    }
  ]
}
