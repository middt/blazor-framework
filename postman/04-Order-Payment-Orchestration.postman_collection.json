    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "manager2_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerKey",
      "value": "CUST-1001",
      "type": "string"
    },
    {
      "key": "customerOnboardingInstanceId",
