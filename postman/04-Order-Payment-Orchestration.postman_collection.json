  "item": [
    {
      "name": "00 - Kimlik Doğrulama (Middt Identity OAuth2)",
      "description": "Middt Identity (`http://localhost:8083`) üzerinden `middt-postman` public client ile JWT Bearer token alır ve otomatik olarak `{{access_token}}`, `{{manager2_access_token}}`, `{{user_access_token}}` değişkenlerine yazar.",
      "item": [
        {
          "name": "1. Token Al - Manager & Admin (test@test.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token başarıyla alındı (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set(\"access_token\", json.access_token);",
                  "    pm.environment.set(\"access_token\", json.access_token);",
                  "    console.log(\"access_token kaydedildi.\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "test@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "test",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid profile email roles offline_access api",
                  "type": "text"
                }
              ]
            },
            "url": "{{idpUrl}}/connect/token",
            "description": "Ana test kullanıcısı (`manager`, `ui-admin`, `idp-admin` rollerine sahip). Alınan token otomatik olarak `{{access_token}}` değişkenine kaydedilir."
          }
        },
