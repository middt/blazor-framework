                  "    }",
                  "} catch (e) {",
                  "    console.warn(\"Response parse warning:\", e);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/sla-escalation/instances",
            "description": "`severity: \"Kritik\"` olduğu için beklemeden doğrudan `escalated` durumuna geçer ve Rebus ile `SlaBreached` bildirimi yayınlar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"SLA-CRIT-{{$randomInt}}\",\n  \"data\": {\n    \"ticketTitle\": \"Kurumsal İnternet Şubesi Erişim Kesintisi\",\n    \"customerName\": \"Global Holding A.Ş.\",\n    \"amount\": 950000,\n    \"severity\": \"Kritik\",\n    \"slaDuration\": \"00:01:00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Akış Durumunu Sorgula (GET Instance)",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/workflows/sla-escalation/instances/{{slaEscalationInstanceId}}",
            "description": "SLA talebinin güncel durumunu (`waiting-agent`, `escalated`, `resolved`), `heartbeatCount` sayacını ve aktif geçişlerini döner."
          }
        },
