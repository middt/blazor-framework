{
  "$comment": "Portable expression language conformance suite. Number text follows ECMAScript Number.prototype.toString (shortest round-trip digits; scientific notation below 1e-6 and from 1e21). Every implementation (Middt.Framework.Expressions.Portable, clients/typescript/ui-core) must produce exactly these results. 'expected' is the JSON value of the result (numbers compare numerically); 'error': true means a syntax/validation error. 'template' cases render a {{ }} template; 'truthy' cases check condition evaluation.",
  "variables": ["data", "query", "row", "record", "instance"],
  "context": {
    "data": {
      "amount": 15000,
      "price": 12.5,
      "name": "Ayşe",
      "note": "",
      "zero": 0,
      "flag": true,
      "customer": { "type": "Kurumsal", "city": "ANKARA", "tags": ["vip", "new"] },
      "items": [ { "qty": 2, "price": 10 }, { "qty": 1, "price": 5.5 } ],
      "nothing": null
    },
    "query": { "id": "42", "tab": "orders" },
    "row": { "firstName": "Debra", "lastName": "Burks", "categoryId": 7 },
    "user": { "id": "7", "name": "test@test.com", "roles": ["manager", "ui-admin"] },
    "now": "2026-10-14T13:00:00.000Z"
  },
  "cases": [
    { "expr": "1", "expected": 1 },
    { "expr": "1.5", "expected": 1.5 },
    { "expr": ".5", "expected": 0.5 },
    { "expr": "\"text\"", "expected": "text" },
    { "expr": "'single'", "expected": "single" },
    { "expr": "\"a\\\"b\"", "expected": "a\"b" },
    { "expr": "true", "expected": true },
    { "expr": "null", "expected": null },

    { "expr": "data.amount", "expected": 15000 },
    { "expr": "data.customer.type", "expected": "Kurumsal" },
    { "expr": "data.customer.missing", "expected": null },
    { "expr": "data.nothing.deeper.still", "expected": null },
    { "expr": "data.missing.x", "expected": null },
    { "expr": "data[\"name\"]", "expected": "Ayşe" },
    { "expr": "data.items[1].price", "expected": 5.5 },
    { "expr": "data.items[5]", "expected": null },
    { "expr": "data.items[-1]", "expected": null },
    { "expr": "data.items[0.5]", "expected": null },
    { "expr": "data.items.Count", "expected": 2 },
    { "expr": "data.items.Length", "expected": 2 },
    { "expr": "data.name.Length", "expected": 4 },
    { "expr": "data.name[0]", "expected": "A" },
    { "expr": "query.id", "expected": "42" },
    { "expr": "record", "expected": null },
    { "expr": "data.customer", "expected": { "type": "Kurumsal", "city": "ANKARA", "tags": ["vip", "new"] } },

    { "expr": "1 + 2 * 3", "expected": 7 },
    { "expr": "(1 + 2) * 3", "expected": 9 },
    { "expr": "10 / 4", "expected": 2.5 },
    { "expr": "10 % 4", "expected": 2 },
    { "expr": "-data.price", "expected": -12.5 },
    { "expr": "1 / 0", "expected": null },
    { "expr": "1 % 0", "expected": null },
    { "expr": "data.amount * data.price", "expected": 187500 },
    { "expr": "data.items[0].qty * data.items[0].price + data.items[1].qty * data.items[1].price", "expected": 25.5 },
    { "expr": "\"5\" * 2", "expected": null },
    { "expr": "null + 1", "expected": null },
    { "expr": "-\"x\"", "expected": null },

    { "expr": "\"Order #\" + data.amount", "expected": "Order #15000" },
    { "expr": "\"p=\" + data.price", "expected": "p=12.5" },
    { "expr": "row.firstName + \" \" + row.lastName", "expected": "Debra Burks" },
    { "expr": "\"x\" + null", "expected": "x" },
    { "expr": "\"b=\" + true", "expected": "b=true" },
    { "expr": "1 + 2 + \"3\"", "expected": "33" },
    { "expr": "\"1\" + 2 + 3", "expected": "123" },
    { "expr": "0.1 + 0.2", "expected": 0.30000000000000004 },

    { "expr": "data.amount > 5000", "expected": true },
    { "expr": "data.amount >= 15000", "expected": true },
    { "expr": "data.amount < 15000", "expected": false },
    { "expr": "\"a\" < \"b\"", "expected": true },
    { "expr": "\"B\" < \"a\"", "expected": true },
    { "expr": "null < 5", "expected": false },
    { "expr": "\"5\" < 6", "expected": false },
    { "expr": "data.customer.type == \"Kurumsal\"", "expected": true },
    { "expr": "data.customer.type != \"Kurumsal\"", "expected": false },
    { "expr": "query.id == 42", "expected": false },
    { "expr": "query.id == \"42\"", "expected": true },
    { "expr": "data.nothing == null", "expected": true },
    { "expr": "data.missing == null", "expected": true },
    { "expr": "null == false", "expected": false },
    { "expr": "data.zero == false", "expected": false },
    { "expr": "data.flag == true", "expected": true },
    { "expr": "data.customer == data.customer", "expected": true },

    { "expr": "true && false", "expected": false },
    { "expr": "true || false", "expected": true },
    { "expr": "data.note && true", "expected": false },
    { "expr": "data.name && 1", "expected": true },
    { "expr": "data.zero || data.nothing", "expected": false },
    { "expr": "!data.note", "expected": true },
    { "expr": "!data.customer", "expected": false },
    { "expr": "!!data.items", "expected": true },
    { "expr": "data.nothing ?? \"default\"", "expected": "default" },
    { "expr": "data.note ?? \"default\"", "expected": "" },
    { "expr": "data.amount > 20000 ? \"high\" : data.amount > 5000 ? \"mid\" : \"low\"", "expected": "mid" },
    { "expr": "data.missing.x != null && data.missing.x > 1", "expected": false },

    { "expr": "user.Name", "expected": "test@test.com" },
    { "expr": "user.Id", "expected": "7" },
    { "expr": "user.IsInRole(\"manager\")", "expected": true },
    { "expr": "user.IsInRole(\"nobody\")", "expected": false },
    { "expr": "user.Roles.Contains(\"ui-admin\")", "expected": true },
    { "expr": "now", "expected": "2026-10-14T13:00:00.000Z" },
    { "expr": "now > \"2026-01-01\"", "expected": true },

    { "expr": "data.name.ToUpper()", "expected": "AYŞE" },
    { "expr": "data.customer.city.ToLower()", "expected": "ankara" },
    { "expr": "\"  x \".Trim()", "expected": "x" },
    { "expr": "data.name.Contains(\"yş\")", "expected": true },
    { "expr": "data.name.StartsWith(\"Ay\")", "expected": true },
    { "expr": "data.name.EndsWith(\"x\")", "expected": false },
    { "expr": "data.customer.tags.Contains(\"vip\")", "expected": true },
    { "expr": "data.customer.tags.Contains(\"old\")", "expected": false },
    { "expr": "data.amount.Contains(\"1\")", "expected": null },
    { "expr": "data.missing.ToUpper()", "expected": null },
    { "expr": "Math.Round(2.5)", "expected": 3 },
    { "expr": "Math.Round(-2.5)", "expected": -3 },
    { "expr": "Math.Round(0.5)", "expected": 1 },
    { "expr": "Math.Round(0.49999999999999994)", "expected": 0 },
    { "expr": "\"x\" + 1000000000000000", "expected": "x1000000000000000" },
    { "expr": "\"x\" + 100000000000000000000", "expected": "x100000000000000000000" },
    { "expr": "\"x\" + 1000000000000000000000", "expected": "x1e+21" },
    { "expr": "\"x\" + 123456789012345678", "expected": "x123456789012345680" },
    { "expr": "\"x\" + 0.00001", "expected": "x0.00001" },
    { "expr": "\"x\" + 0.000001", "expected": "x0.000001" },
    { "expr": "\"x\" + 0.0000001", "expected": "x1e-7" },
    { "expr": "\"x\" + 0.000000123", "expected": "x1.23e-7" },
    { "expr": "\"x\" + -2.5", "expected": "x-2.5" },
    { "expr": "\"x\" + 123456789012345", "expected": "x123456789012345" },
    { "expr": "\"x\" + Math", "expected": "x" },
    { "expr": "Math.Round(1.005 * 1000) / 1000", "expected": 1.005 },
    { "expr": "Math.Round(12.345, 2)", "expected": 12.35 },
    { "expr": "Math.Abs(-3)", "expected": 3 },
    { "expr": "Math.Floor(2.7)", "expected": 2 },
    { "expr": "Math.Ceiling(2.1)", "expected": 3 },
    { "expr": "Math.Min(3, 7)", "expected": 3 },
    { "expr": "Math.Max(data.amount, 20000)", "expected": 20000 },
    { "expr": "Math.Round(\"x\")", "expected": null },

    { "expr": "", "error": true },
    { "expr": "data.", "error": true },
    { "expr": "1 +", "error": true },
    { "expr": "(1", "error": true },
    { "expr": "\"open", "error": true },
    { "expr": "unknownVariable", "error": true },
    { "expr": "data.name.GetType()", "error": true },
    { "expr": "System.IO.File", "error": true },
    { "expr": "data.amount = 5", "error": true },
    { "expr": "a => a", "error": true },
    { "expr": "data.amount 5", "error": true },
    { "expr": "1 ? 2", "error": true },
    { "expr": "data @ 1", "error": true },
    { "expr": "new object()", "error": true },

    { "template": "plain text", "expected": "plain text" },
    { "template": "{{ data.amount }}", "expected": 15000 },
    { "template": "{{ data.customer.tags }}", "expected": ["vip", "new"] },
    { "template": "{{ data.nothing }}", "expected": null },
    { "template": "Sipariş #{{ data.amount }} · {{ row.firstName }}", "expected": "Sipariş #15000 · Debra" },
    { "template": "a{{ data.nothing }}b", "expected": "ab" },
    { "template": "{{data.flag}}/{{ data.price }}", "expected": "true/12.5" },
    { "template": "tags: {{ data.customer.tags }}", "expected": "tags: [\"vip\",\"new\"]" },
    { "template": "c={{ data.customer }}", "expected": "c={\"type\":\"Kurumsal\",\"city\":\"ANKARA\",\"tags\":[\"vip\",\"new\"]}" },
    { "template": "n={{ data.name }}/{{ data.price * 2 }}", "expected": "n=Ayşe/25" },
    { "template": "/ui/bike-category-products?id={{ row.categoryId }}", "expected": "/ui/bike-category-products?id=7" },
    { "template": "{{ 1 + }}", "error": true },

    { "truthy": "data.note", "expected": false },
    { "truthy": "data.name", "expected": true },
    { "truthy": "data.zero", "expected": false },
    { "truthy": "data.items", "expected": true },
    { "truthy": "data.missing", "expected": false },
    { "truthy": "data.amount > 20000", "expected": false }
  ]
}
