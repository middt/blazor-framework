{
  "$comment": "Shared JSON Patch (RFC 6902) cases. 'diff' is run by .NET (Middt.Framework.Expressions.JsonPatch.Diff, tests/…/Expressions/JsonPatchConformanceTests.cs) and TypeScript (jsonPatchDiff in @middt/ui-core, sdk/client/ui-core/test/json-patch.test.ts) and must produce exactly 'patch' (same operations, same order); applying 'patch' to 'from' must give 'to'. 'apply' is run by .NET only (JsonPatch.ApplyStrict, which applies client patches of input.format: jsonPatch): 'result' is the document afterwards, 'error' an invalid patch (400), 'conflict' a failed test operation (409). Keys are non-numeric on purpose: JavaScript orders integer-like keys first.",
  "diff": [
    { "name": "equal documents", "from": { "a": 1, "b": { "c": [1, 2] } }, "to": { "a": 1, "b": { "c": [1, 2] } }, "patch": [] },
    { "name": "changed scalar", "from": { "a": 1, "b": "x" }, "to": { "a": 2, "b": "x" }, "patch": [ { "op": "replace", "path": "/a", "value": 2 } ] },
    { "name": "added and removed members", "from": { "keep": true, "gone": "x" }, "to": { "keep": true, "added": { "n": 1 } },
      "patch": [ { "op": "remove", "path": "/gone" }, { "op": "add", "path": "/added", "value": { "n": 1 } } ] },
    { "name": "nested objects are walked", "from": { "contact": { "phone": "1", "mail": "a@x" } }, "to": { "contact": { "phone": "2", "mail": "a@x" } },
      "patch": [ { "op": "replace", "path": "/contact/phone", "value": "2" } ] },
    { "name": "arrays are replaced whole", "from": { "tags": [ "a", "b" ] }, "to": { "tags": [ "a", "b", "c" ] },
      "patch": [ { "op": "replace", "path": "/tags", "value": [ "a", "b", "c" ] } ] },
    { "name": "type change object to scalar", "from": { "x": { "y": 1 } }, "to": { "x": "y" }, "patch": [ { "op": "replace", "path": "/x", "value": "y" } ] },
    { "name": "null is a value, not a removal", "from": { "a": 1 }, "to": { "a": null }, "patch": [ { "op": "replace", "path": "/a", "value": null } ] },
    { "name": "pointer escaping", "from": {}, "to": { "a/b": 1, "c~d": 2 },
      "patch": [ { "op": "add", "path": "/a~1b", "value": 1 }, { "op": "add", "path": "/c~0d", "value": 2 } ] },
    { "name": "order: removals and changes first, additions last", "from": { "first": 1, "second": 2 }, "to": { "zeta": 0, "second": 3 },
      "patch": [ { "op": "remove", "path": "/first" }, { "op": "replace", "path": "/second", "value": 3 }, { "op": "add", "path": "/zeta", "value": 0 } ] }
  ],
  "apply": [
    { "name": "replace and add", "document": { "phone": "1" }, "patch": [ { "op": "replace", "path": "/phone", "value": "2" }, { "op": "add", "path": "/fax", "value": "3" } ],
      "result": { "phone": "2", "fax": "3" } },
    { "name": "replace keeps the member's position", "document": { "a": 1, "b": 2, "c": 3 }, "patch": [ { "op": "replace", "path": "/a", "value": 9 } ], "result": { "a": 9, "b": 2, "c": 3 }, "resultText": "{\"a\":9,\"b\":2,\"c\":3}" },
    { "name": "replace an array item", "document": { "tags": [ "a", "b" ] }, "patch": [ { "op": "replace", "path": "/tags/1", "value": "z" } ], "result": { "tags": [ "a", "z" ] } },
    { "name": "remove", "document": { "phone": "1", "fax": "3" }, "patch": [ { "op": "remove", "path": "/fax" } ], "result": { "phone": "1" } },
    { "name": "append to an array with -", "document": { "tags": [ "a" ] }, "patch": [ { "op": "add", "path": "/tags/-", "value": "b" } ], "result": { "tags": [ "a", "b" ] } },
    { "name": "insert into an array", "document": { "tags": [ "a", "c" ] }, "patch": [ { "op": "add", "path": "/tags/1", "value": "b" } ], "result": { "tags": [ "a", "b", "c" ] } },
    { "name": "remove from an array", "document": { "tags": [ "a", "b", "c" ] }, "patch": [ { "op": "remove", "path": "/tags/0" } ], "result": { "tags": [ "b", "c" ] } },
    { "name": "move", "document": { "old": { "v": 1 } }, "patch": [ { "op": "move", "from": "/old", "path": "/new" } ], "result": { "new": { "v": 1 } } },
    { "name": "copy", "document": { "a": [ 1 ] }, "patch": [ { "op": "copy", "from": "/a", "path": "/b" } ], "result": { "a": [ 1 ], "b": [ 1 ] } },
    { "name": "test passes", "document": { "version": 3, "x": 1 }, "patch": [ { "op": "test", "path": "/version", "value": 3 }, { "op": "replace", "path": "/x", "value": 2 } ],
      "result": { "version": 3, "x": 2 } },
    { "name": "add into a missing parent", "document": {}, "patch": [ { "op": "add", "path": "/a/b", "value": 1 } ], "error": true },
    { "name": "remove a missing member", "document": { "a": 1 }, "patch": [ { "op": "remove", "path": "/b" } ], "error": true },
    { "name": "replace a missing member", "document": {}, "patch": [ { "op": "replace", "path": "/a", "value": 1 } ], "error": true },
    { "name": "array index out of range", "document": { "tags": [ "a" ] }, "patch": [ { "op": "add", "path": "/tags/5", "value": "b" } ], "error": true },
    { "name": "leading zero index", "document": { "tags": [ "a", "b" ] }, "patch": [ { "op": "remove", "path": "/tags/01" } ], "error": true },
    { "name": "replacing the root", "document": { "a": 1 }, "patch": [ { "op": "replace", "path": "", "value": {} } ], "error": true },
    { "name": "unknown operation", "document": {}, "patch": [ { "op": "merge", "path": "/a", "value": 1 } ], "error": true },
    { "name": "missing value", "document": {}, "patch": [ { "op": "add", "path": "/a" } ], "error": true },
    { "name": "move into its own child", "document": { "a": { "b": 1 } }, "patch": [ { "op": "move", "from": "/a", "path": "/a/c" } ], "error": true },
    { "name": "a failing operation leaves the document unchanged", "document": { "a": 1 }, "patch": [ { "op": "replace", "path": "/a", "value": 2 }, { "op": "remove", "path": "/missing" } ], "error": true },
    { "name": "test fails", "document": { "version": 3 }, "patch": [ { "op": "test", "path": "/version", "value": 2 } ], "conflict": true }
  ]
}
