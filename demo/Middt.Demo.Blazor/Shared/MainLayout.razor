@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-px-2">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenLabel Text="Middt Framework Sample Application" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenAppearanceToggle />
                <RadzenDropDown TValue="string" Data="@themes" Value="@ThemeService.Theme" Change="@(value => ThemeService.SetTheme((string)value))" Style="width: 140px" />
                <RadzenSplitButton Text="@BaseTokenHelper.Username()" Icon="account_circle" Click="OnUserButtonClick">
                    <ChildContent>
                        <RadzenSplitButtonItem Text="Profile" Value="profile" Icon="account_box" />
                        <RadzenSplitButtonItem Text="Logout" Value="logout" Icon="logout" />
                    </ChildContent>
                </RadzenSplitButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            @foreach (var item in MenuService.MenuItems)
            {
                if (item.Children is { } children)
                {
                    <RadzenPanelMenuItem @key="item.Path" Text="@item.Name" Icon="@item.Icon" @bind-Expanded="item.Expanded">
                        @foreach (var child in children)
                        {
                            <RadzenPanelMenuItem @key="child.Path" Text="@child.Name" Path="@child.Path" Icon="@child.Icon" />
                        }
                    </RadzenPanelMenuItem>
                }
                else
                {
                    <RadzenPanelMenuItem @key="item.Path" Text="@item.Name" Path="@item.Path" Icon="@item.Icon" />
                }
            }
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenFooter>
        <RadzenLabel Text="@($"Middt Framework, Copyright © {DateTime.UtcNow.Year}")" />
    </RadzenFooter>
</RadzenLayout>
