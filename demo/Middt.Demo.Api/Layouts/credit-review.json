{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "credit-review",
  "title": "Kredi Tahsis & Komite İnceleme Özeti",
  "kind": "view",
  "version": 3,
  "body": [
    {
      "widget": "alert",
      "severity": "warning",
      "text": "4-Göz İlkesi: 2. Onay aşaması 1. onayı veren yetkiliden farklı bir yönetici tarafından onaylanmalıdır.",
      "visibleWhen": "instance.state == \"stage2-approval\""
    },
    {
      "widget": "alert",
      "severity": "danger",
      "text": "Yüksek LTV Oranı (%{{ data.ltvRatio }}): Ek teminat veya üst komite incelemesi önerilir.",
      "visibleWhen": "data.ltvRatio != null && data.ltvRatio > 80"
    },
    {
      "widget": "columns",
      "widths": [ "2", "1" ],
      "children": [
        {
          "widget": "section",
          "title": "{{ data.customerName }} — Kredi Talebi",
          "children": [
            {
              "widget": "fields",
              "items": [
                { "label": "Müşteri Anahtarı", "value": "{{ data.customerKey }}", "visibleWhen": "data.customerKey != null" },
                { "label": "Talep Edilen Kredi (₺)", "value": "{{ data.amount }}", "format": "N2" },
                { "label": "Vade (Ay)", "value": "{{ data.termMonths }}", "visibleWhen": "data.termMonths != null" },
                { "label": "Teminat Değeri (₺)", "value": "{{ data.collateralAmount }}", "format": "N2", "visibleWhen": "data.collateralAmount != null" },
                { "label": "Kredi / Teminat Oranı (LTV %)", "value": "{{ data.ltvRatio }}", "format": "N2", "visibleWhen": "data.ltvRatio != null" },
                { "label": "Aktarım IBAN", "value": "{{ data.iban }}", "visibleWhen": "data.iban != null" },
                { "label": "Talep Eden", "value": "{{ data.requestedBy }}", "visibleWhen": "data.requestedBy != null" },
                { "label": "Talep Zamanı", "value": "{{ data.requestedAt }}", "format": "g", "visibleWhen": "data.requestedAt != null" }
              ]
            }
          ]
        },
        {
          "widget": "section",
          "title": "Onay & Komite Durumu",
          "children": [
            { "widget": "badge", "color": "info", "text": "1. Onay Bekleniyor", "visibleWhen": "instance.state == \"stage1-approval\"" },
            { "widget": "badge", "color": "warning", "text": "2. Onay (4-Göz Komite)", "visibleWhen": "instance.state == \"stage2-approval\"" },
            {
              "widget": "fields",
              "items": [
                { "label": "1. Onaycı", "value": "{{ data.stage1ApprovedBy }}", "visibleWhen": "data.stage1ApprovedBy != null" },
                { "label": "1. Onaycı Görüşü", "value": "{{ data.stage1Comment }}", "visibleWhen": "data.stage1Comment != null" },
                { "label": "2. Onaycı", "value": "{{ data.stage2ApprovedBy }}", "visibleWhen": "data.stage2ApprovedBy != null" },
                { "label": "2. Onaycı Görüşü", "value": "{{ data.stage2Comment }}", "visibleWhen": "data.stage2Comment != null" },
                { "label": "Komite Gizli Notu", "value": "{{ data.committeeSecretNote }}", "visibleWhen": "user.IsInRole(\"manager\") && data.committeeSecretNote != null" }
              ]
            }
          ]
        }
      ]
    },
    {
      "widget": "columns",
      "widths": [ "1", "1" ],
      "children": [
        {
          "widget": "layout",
          "key": "customer-summary-card",
          "data": "data.customer",
          "visibleWhen": "data.customer != null"
        },
        {
          "widget": "layout",
          "key": "risk-eval-card",
          "data": "data.riskResult",
          "visibleWhen": "data.riskResult != null"
        }
      ]
    },
    { "widget": "layout", "key": "workflow-footer" }
  ]
}
