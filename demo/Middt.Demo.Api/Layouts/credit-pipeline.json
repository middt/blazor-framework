{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "credit-pipeline",
  "title": "Kredi Tahsis Portföyü (Workflow JSON)",
  "kind": "page",
  "version": 3,
  "body": [
    { "widget": "heading", "text": "Kredi Tahsis Portföyü (Workflow JSON Verisi)" },
    { "widget": "link", "text": "Yeni Kredi Tahsis Talebi", "href": "/workflow/credit-allocation?start=1", "style": "button" },
    {
      "widget": "grid",
      "id": "credits",
      "entity": "CreditAllocation",
      "columns": [
        { "field": "customerKey", "title": "Müşteri", "width": "170px" },
        { "field": "customerName", "title": "Müşteri Adı" },
        { "field": "amount", "title": "Kredi Tutarı", "format": "N2", "width": "150px" },
        { "field": "termMonths", "title": "Vade (Ay)", "width": "110px" },
        { "field": "ltvRatio", "title": "LTV (%)", "width": "110px" },
        { "field": "iban", "title": "IBAN (Maskeli)", "width": "180px" },
        { "field": "stateTitle", "title": "Onay Aşaması", "width": "200px" }
      ],
      "search": [
        { "field": "customerKey", "label": "Müşteri Anahtarı" },
        {
          "field": "state",
          "label": "Onay Aşaması",
          "type": "select",
          "options": [
            { "value": "stage1-approval", "text": "1. Onay: Tahsis Yetkilisi" },
            { "value": "stage2-approval", "text": "2. Onay: Kredi Komitesi (4-Göz İlkesi)" },
            { "value": "disbursed", "text": "Kredi Kullandırıldı" },
            { "value": "rejected", "text": "Kredi Reddedildi" }
          ]
        },
        { "field": "amount_min", "label": "Min Kredi Tutarı (≥)", "type": "number" },
        { "field": "amount_max", "label": "Max Kredi Tutarı (≤)", "type": "number" },
        { "field": "termMonths_min", "label": "Min Vade (≥)", "type": "integer" },
        { "field": "termMonths_max", "label": "Max Vade (≤)", "type": "integer" },
        { "field": "createdAt_from", "label": "Başlangıç Tarihi", "type": "date" },
        { "field": "createdAt_to", "label": "Bitiş Tarihi", "type": "date" }
      ]
    }
  ]
}
