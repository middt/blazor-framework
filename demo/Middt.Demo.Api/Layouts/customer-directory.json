{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "customer-directory",
  "title": "Müşteri Rehberi (Workflow JSON)",
  "kind": "page",
  "version": 3,
  "body": [
    { "widget": "heading", "text": "Müşteri Rehberi (Workflow JSON Verisi)" },
    { "widget": "link", "text": "Yeni Müşteri Kaydı Başlat", "href": "/workflow/customer-onboarding?start=1", "style": "button" },
    {
      "widget": "grid",
      "id": "customers",
      "entity": "CustomerOnboarding",
      "columns": [
        { "field": "key", "title": "Müşteri Anahtarı", "width": "170px" },
        { "field": "fullName", "title": "Ad Soyad / Ünvan" },
        { "field": "identityNumber", "title": "Kimlik / Vergi No (Maskeli)", "width": "180px" },
        { "field": "segment", "title": "Segment", "width": "120px" },
        { "field": "monthlyIncome", "title": "Aylık Gelir", "format": "N0", "width": "130px" },
        { "field": "kycScore", "title": "KYC Skoru", "width": "110px" },
        { "field": "riskLevel", "title": "Risk", "width": "110px" },
        { "field": "stateTitle", "title": "Akış Durumu", "width": "160px" }
      ],
      "search": [
        { "field": "fullName", "label": "Ad Soyad / Ünvan" },
        { "field": "segment", "label": "Segment", "type": "select", "options": [ "Bireysel", "KOBİ", "Kurumsal" ] },
        { "field": "riskLevel", "label": "Risk Seviyesi", "type": "select", "options": [ "Düşük", "Orta", "Yüksek" ] },
        { "field": "monthlyIncome_min", "label": "Min Aylık Gelir (≥)", "type": "number" },
        { "field": "monthlyIncome_max", "label": "Max Aylık Gelir (≤)", "type": "number" },
        { "field": "createdAt_from", "label": "Başlangıç Tarihi", "type": "date" },
        { "field": "createdAt_to", "label": "Bitiş Tarihi", "type": "date" }
      ]
    }
  ]
}
