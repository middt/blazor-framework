{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "order-result",
  "title": "Akış Karar & Sonuç Özeti",
  "kind": "view",
  "version": 2,
  "body": [
    {
      "widget": "alert",
      "severity": "success",
      "text": "İşlem başarıyla onaylandı ve tamamlandı.",
      "visibleWhen": "instance.state == \"completed\" || instance.state == \"disbursed\" || instance.state == \"approved\""
    },
    {
      "widget": "alert",
      "severity": "danger",
      "text": "İşlem reddedildi veya iptal edildi: {{ data.reason }}",
      "visibleWhen": "instance.state == \"rejected\" || instance.state == \"cancelled\""
    },
    {
      "widget": "section",
      "title": "İşlem Sonuç Bilgileri",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "Müşteri", "value": "{{ data.customerName }}", "visibleWhen": "data.customerName != null" },
            { "label": "Müşteri Anahtarı", "value": "{{ data.customerKey }}", "visibleWhen": "data.customerKey != null" },
            { "label": "Tutar", "value": "{{ data.amount }}", "format": "N2", "visibleWhen": "data.amount != null" },
            { "label": "Vade (Ay)", "value": "{{ data.termMonths }}", "visibleWhen": "data.termMonths != null" },
            { "label": "Kredi / Teminat Oranı (%)", "value": "{{ data.ltvRatio }}", "visibleWhen": "data.ltvRatio != null" },
            { "label": "Ödeme Yöntemi", "value": "{{ data.paymentMethod }}", "visibleWhen": "data.paymentMethod != null" },
            { "label": "Ödeme Referansı", "value": "{{ data.paymentReceipt }}", "visibleWhen": "data.paymentReceipt != null" },
            { "label": "1. Onaycı", "value": "{{ data.stage1ApprovedBy }}", "visibleWhen": "data.stage1ApprovedBy != null" },
            { "label": "2. Onaycı / Komite", "value": "{{ data.stage2ApprovedBy }}", "visibleWhen": "data.stage2ApprovedBy != null" },
            { "label": "Onaylayan", "value": "{{ data.verifiedBy }}", "visibleWhen": "data.verifiedBy != null" },
            { "label": "Reddeden", "value": "{{ data.rejectedBy }}", "visibleWhen": "data.rejectedBy != null" },
            { "label": "Red / İptal Nedeni", "value": "{{ data.reason }}", "visibleWhen": "data.reason != null" }
          ]
        }
      ]
    },
    { "widget": "layout", "key": "workflow-footer" }
  ]
}
