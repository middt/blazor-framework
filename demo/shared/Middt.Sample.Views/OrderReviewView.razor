@* State view of the review states (finance-review / manager-review / express-review / escalated): what a manager needs to decide. *@
@attribute [WorkflowView("order-review")]
@inherits WorkflowViewBase

<article class="sv-view" aria-labelledby="sv-review-title">
    <header class="sv-header">
        <h3 id="sv-review-title">Sipariş #@Text("orderId") · @Text("customerName")</h3>
        <span class="@ViewFormat.ScoreClass(Number("credit.score"))" title="Kredi skoru">Skor @Text("credit.score")</span>
    </header>

    @if (ViewFormat.ReviewLevel(Instance.State) is { } level)
    {
        <p class="sv-level" data-level="@Instance.State">@level</p>
    }

    @if (Instance.State == "escalated")
    {
        <p class="sv-alert" role="status">Bu sipariş süresi içinde karara bağlanmadığı için eskale edildi.</p>
    }

    @if (Number("amount") > 20000)
    {
        <p class="sv-alert sv-alert-danger" role="status">Yüksek tutar: ek kontrol önerilir.</p>
    }

    @if (IsExpress)
    {
        <p class="sv-alert sv-express" role="status">Ekspres teslimat istendi.</p>
    }

    <dl class="sv-grid">
        <dt>Tutar</dt>
        <dd class="sv-amount">@ViewFormat.Money(Number("amount"))</dd>
        @if (Has("product"))
        {
            <dt>Ürün grubu</dt>
            <dd>@Text("product")</dd>
        }
        @if (Has("deliveryType"))
        {
            <dt>Teslimat</dt>
            <dd><span class="@(IsExpress ? "sv-badge sv-express" : "sv-badge")">@Text("deliveryType")</span></dd>
        }
        @if (Has("customerType"))
        {
            <dt>Müşteri tipi</dt>
            <dd>@Text("customerType")</dd>
        }
        @if (Has("email"))
        {
            <dt>E-posta</dt>
            <dd>@Text("email")</dd>
        }
        <dt>Talep eden</dt>
        <dd>@Text("requestedBy")</dd>
        <dt>Talep zamanı</dt>
        <dd>@ViewFormat.Date(Date("requestedAt"))</dd>
        <dt>Kredi kontrolü</dt>
        <dd>@ViewFormat.Date(Date("credit.checkedAt"))</dd>
    </dl>

    @if (Has("company.taxNumber"))
    {
        <section class="sv-section" aria-labelledby="sv-review-company">
            <h4 id="sv-review-company">Firma bilgileri</h4>
            <dl class="sv-grid">
                <dt>Vergi numarası</dt>
                <dd>@Text("company.taxNumber")</dd>
                <dt>Vergi dairesi</dt>
                <dd>@Text("company.taxOffice")</dd>
                <dt>Yetkili kişi</dt>
                <dd>@Text("company.contactPerson")</dd>
            </dl>
        </section>
    }
    else if (Has("person.identityNumber"))
    {
        <section class="sv-section" aria-labelledby="sv-review-person">
            <h4 id="sv-review-person">Kimlik bilgileri</h4>
            <dl class="sv-grid">
                <dt>T.C. kimlik no</dt>
                <dd>@ViewFormat.MaskIdentity(Text("person.identityNumber", string.Empty))</dd>
                <dt>Doğum tarihi</dt>
                <dd>@ViewFormat.DateOnly(Date("person.birthDate"))</dd>
                @if (Has("person.phone"))
                {
                    <dt>Telefon</dt>
                    <dd>@Text("person.phone")</dd>
                }
            </dl>
        </section>
    }

    @if (Text("note", string.Empty) is { Length: > 0 } note)
    {
        <blockquote class="sv-note">@note</blockquote>
    }

    @if (!Interactive)
    {
        <p class="sv-muted">Karar için uygulamadaki işlemleri (Onayla / Reddet@(Instance.State == "express-review" ? " / Standart teslimata çevir" : null)) kullanın.</p>
    }
</article>

@code {
    private bool Has(string path) => Text(path, string.Empty).Length > 0;

    private bool IsExpress => Text("deliveryType", string.Empty) == "Ekspres";
}
