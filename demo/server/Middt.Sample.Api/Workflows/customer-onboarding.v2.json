{
  // 6/8 and the lifecycle of a customer (one instance per customer, business key "customer-<id>"): Bireysel / Kurumsal →
  // identity (TCKN) or company (tax number) → contact & address → verification by a manager → bike-create-customer
  // (customers table) → "active": change requests (bike-update-customer) and the close request (bike-set-active false:
  // no new orders, existing orders stay). Started with a customerId it adopts that customer.
  "key": "customer-onboarding",
  "version": 2,
  "title": "Müşteri kaydı",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": {
    "key": "start",
    "target": "entry",
    // Optional: an existing record (adoption). The UI starts with business key "<entity>-<id>" and this id, so an
    // existing lifecycle instance of the record is returned instead of a new one.
    "input": { "schema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "customerId": { "type": "integer", "minimum": 1, "title": "Mevcut kayıt (yeni kayıt için boş bırakın)",
                      "x-lookup": { "entity": "Customer", "valueField": "customerId", "textField": "name" } }
      } } },
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "entry", "title": "Başlangıç",
      "transitions": [
        { "key": "adopt", "target": "loading", "trigger": "Automatic", "rule": "data.customerId != null",
          "onExecute": [ { "task": "set", "config": { "values": { "adoptedAt": "now" } } } ] },
        { "key": "new", "target": "customer", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "customer", "title": "Müşteri tipi", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit-type", "title": "Devam", "target": "type-routing", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "customerType" ],
            "properties": {
              "customerType": { "type": "string", "enum": [ "Bireysel", "Kurumsal" ], "title": "Müşteri tipi" }
            } } }
        }
      ]
    },
    {
      "key": "type-routing", "title": "Müşteri tipi kontrolü",
      "transitions": [
        { "key": "to-company", "target": "company", "trigger": "Automatic", "rule": "data.customerType == \"Kurumsal\"" },
        { "key": "to-person", "target": "person", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "person", "title": "Kimlik bilgileri", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "submit-person", "title": "Devam", "target": "contact", "view": { "inline": true },
          "input": { "into": "person", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "firstName", "lastName", "identityNumber", "birthDate" ],
            "properties": {
              "firstName": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Ad" },
              "lastName": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Soyad" },
              "identityNumber": { "type": "string", "pattern": "^[1-9][0-9]{10}$", "title": "T.C. kimlik no (11 hane)" },
              "birthDate": { "type": "string", "format": "date-time", "title": "Doğum tarihi" }
            } } }
        },
        { "key": "back", "title": "Geri", "target": "customer" }
      ]
    },
    {
      "key": "company", "title": "Firma bilgileri", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "submit-company", "title": "Devam", "target": "contact", "view": { "inline": true },
          "input": { "into": "company", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "companyName", "taxNumber", "taxOffice", "contactPerson" ],
            "properties": {
              "companyName": { "type": "string", "minLength": 2, "maxLength": 200, "title": "Firma unvanı" },
              "taxNumber": { "type": "string", "pattern": "^[0-9]{10}$", "title": "Vergi numarası (10 hane)" },
              "taxOffice": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Vergi dairesi" },
              "contactPerson": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Yetkili kişi" }
            } } }
        },
        { "key": "back", "title": "Geri", "target": "customer" }
      ]
    },
    {
      "key": "contact", "title": "İletişim ve adres", "step": 3, "subType": "Human",
      "transitions": [
        {
          "key": "submit-contact", "title": "Doğrulamaya gönder", "target": "verification", "view": { "inline": true },
          "input": { "into": "contact", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "email", "city" ],
            "properties": {
              "email": { "type": "string", "format": "email", "maxLength": 255, "title": "E-posta" },
              "phone": { "type": "string", "pattern": "^\\+?[0-9 ()-]{7,25}$", "maxLength": 25, "title": "Telefon" },
              "street": { "type": "string", "maxLength": 255, "title": "Adres" },
              "city": { "type": "string", "minLength": 2, "maxLength": 50, "title": "Şehir" },
              "state": { "type": "string", "maxLength": 25, "title": "İl / eyalet" },
              "zipCode": { "type": "string", "pattern": "^[0-9]{5}$", "title": "Posta kodu" }
            } } }
        },
        { "key": "back-company", "title": "Geri", "target": "company", "rule": "data.customerType == \"Kurumsal\"" },
        { "key": "back-person", "title": "Geri", "target": "person", "rule": "data.customerType != \"Kurumsal\"" }
      ]
    },
    {
      "key": "verification", "title": "Doğrulama", "step": 4, "subType": "Human",
      "transitions": [
        { "key": "verify", "title": "Doğrula ve kaydet", "target": "creating", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "back", "title": "Düzenle", "target": "contact" }
      ]
    },
    {
      "key": "creating", "title": "Müşteri kaydediliyor",
      "onEntry": [
        // customers has first/last name only: a company is stored as "<unvan>" + "<yetkili kişi>".
        { "task": "set", "when": "data.customerType == \"Kurumsal\"",
          "config": { "values": { "customer.firstName": "data.company.companyName", "customer.lastName": "data.company.contactPerson" } } },
        { "task": "set", "when": "data.customerType != \"Kurumsal\"",
          "config": { "values": { "customer.firstName": "data.person.firstName", "customer.lastName": "data.person.lastName" } } },
        { "task": "bike-create-customer", "config": {
          "firstName": "{{ data.customer.firstName }}", "lastName": "{{ data.customer.lastName }}",
          "email": "{{ data.contact.email }}", "phone": "{{ data.contact.phone }}", "street": "{{ data.contact.street }}",
          "city": "{{ data.contact.city }}", "state": "{{ data.contact.state }}", "zipCode": "{{ data.contact.zipCode }}",
          "into": "customerId" } }
      ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "created", "target": "loading", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "registeredAt": "now" } } } ] }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 4, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Bilgileri düzelt", "target": "contact", "input": { "set": { "error": "null" } } } ]
    },
    // ───────────── lifecycle: one instance per record (business key "customer-<id>"), closing = deactivating ─────────────
    {
      // Reached after the create task, after every approved change and when an existing record is adopted.
      "key": "loading", "title": "Kayıt yükleniyor",
      "onEntry": [
        { "task": "bike-load-record", "config": { "entity": "customer", "id": "{{ data.customerId }}", "into": "customer" } },
        { "task": "setKey", "when": "data.error == null", "config": { "key": "customer-{{ data.customerId }}" } },
        // Prefill of the change request form: the current values.
        { "task": "set", "when": "data.error == null", "config": { "values": { "change": "data.customer" } } }
      ],
      "transitions": [
        { "key": "load-failed", "target": "not-found", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "to-inactive", "target": "inactive", "trigger": "Automatic", "rule": "data.customer.active == false" },
        { "key": "to-active", "target": "active", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "active", "title": "Aktif", "step": 5, "subType": "Human",
      "transitions": [
        {
          "key": "request-change", "title": "Değişiklik talebi", "target": "change-approval", "view": { "inline": true },
          "input": { "into": "change", "schema": {
              "type": "object", "additionalProperties": false, "required": [ "firstName", "lastName", "email" ],
              "properties": {
                "firstName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Ad / unvan" },
                "lastName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Soyad / yetkili" },
                "email": { "type": "string", "format": "email", "maxLength": 255, "title": "E-posta" },
                "phone": { "type": "string", "pattern": "^\\+?[0-9 ()-]{7,25}$", "maxLength": 25, "title": "Telefon" },
                "street": { "type": "string", "maxLength": 255, "title": "Adres" },
                "city": { "type": "string", "maxLength": 50, "title": "Şehir" },
                "state": { "type": "string", "maxLength": 25, "title": "İl / eyalet" },
                "zipCode": { "type": "string", "pattern": "^[0-9]{5}$", "title": "Posta kodu" }
              } },
            // The request replaces data.change (a cleared optional field is removed, not kept from the prefill).
            "set": { "change": "input", "changeRequest.by": "user.Name", "changeRequest.at": "now", "changeReview": "null" } }
        },
        {
          "key": "request-close", "title": "Kapatma talebi", "target": "close-approval",
          "input": { "into": "closeRequest", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Kapatma nedeni" } } },
            "set": { "closeRequest.by": "user.Name", "closeRequest.at": "now", "closeReview": "null" } }
        }
      ]
    },
    {
      "key": "change-approval", "title": "Değişiklik onayı", "step": 5, "subType": "Human",
      "transitions": [
        { "key": "approve-change", "title": "Onayla", "target": "updating", "roles": [ "manager" ],
          "input": { "into": "changeReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "changeReview.approvedBy": "user.Name", "changeReview.decidedAt": "now" } } },
        // Rejected: the record keeps its values, the form is prefilled with them again.
        { "key": "reject-change", "title": "Reddet", "target": "active", "roles": [ "manager" ],
          "input": { "into": "changeReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "changeReview.rejectedBy": "user.Name", "changeReview.decidedAt": "now", "change": "data.customer" } } },
        { "key": "withdraw-change", "title": "Talebi geri çek", "target": "active", "input": { "set": { "change": "data.customer" } } }
      ]
    },
    {
      "key": "updating", "title": "Değişiklik kaydediliyor",
      "onEntry": [ { "task": "bike-update-customer", "config": {
        "id": "{{ data.customerId }}", "firstName": "{{ data.change.firstName }}", "lastName": "{{ data.change.lastName }}",
        "email": "{{ data.change.email }}", "phone": "{{ data.change.phone }}", "street": "{{ data.change.street }}",
        "city": "{{ data.change.city }}", "state": "{{ data.change.state }}", "zipCode": "{{ data.change.zipCode }}" } } ],
      "transitions": [
        { "key": "update-failed", "target": "change-fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "updated", "target": "loading", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "changedAt": "now" } } } ] }
      ]
    },
    {
      // Rule violation of a change or close (duplicate name, category with active products …): back to the record,
      // a change request form is prefilled with the values just tried.
      "key": "change-fix", "title": "Düzeltme gerekli", "step": 5, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "back-to-record", "title": "Kayda dön", "target": "active", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "close-approval", "title": "Kapatma onayı", "step": 5, "subType": "Human",
      "transitions": [
        { "key": "approve-close", "title": "Onayla", "target": "closing", "roles": [ "manager" ],
          "input": { "into": "closeReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "closeReview.approvedBy": "user.Name", "closeReview.decidedAt": "now" } } },
        { "key": "reject-close", "title": "Reddet", "target": "active", "roles": [ "manager" ],
          "input": { "into": "closeReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "closeReview.rejectedBy": "user.Name", "closeReview.decidedAt": "now" } } },
        { "key": "withdraw-close", "title": "Talebi geri çek", "target": "active" }
      ]
    },
    {
      // Soft delete: the record stays (orders keep referencing it) but is no longer offered in lookups.
      "key": "closing", "title": "Kayıt kapatılıyor",
      "onEntry": [ { "task": "bike-set-active", "config": { "entity": "customer", "id": "{{ data.customerId }}", "active": false } } ],
      "transitions": [
        { "key": "close-failed", "target": "change-fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "deactivated", "target": "closed", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "closed", "title": "Kapatıldı", "step": 5, "type": "Finish", "subType": "Success",
      "onEntry": [ { "task": "set", "config": { "values": { "closedAt": "now", "customer.active": "false" } } } ] },
    {
      // An adopted record that was already passive (closed before the lifecycle existed).
      "key": "inactive", "title": "Pasif", "step": 5, "subType": "Human",
      "transitions": [
        { "key": "request-reactivate", "title": "Yeniden etkinleştirme talebi", "target": "reactivate-approval",
          "input": { "into": "reactivateRequest", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Gerekçe" } } },
            "set": { "reactivateRequest.by": "user.Name", "reactivateRequest.at": "now", "reactivateReview": "null" } } }
      ]
    },
    {
      "key": "reactivate-approval", "title": "Etkinleştirme onayı", "step": 5, "subType": "Human",
      "transitions": [
        { "key": "approve-reactivate", "title": "Onayla", "target": "reactivating", "roles": [ "manager" ],
          "input": { "into": "reactivateReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "reactivateReview.approvedBy": "user.Name", "reactivateReview.decidedAt": "now" } } },
        { "key": "reject-reactivate", "title": "Reddet", "target": "inactive", "roles": [ "manager" ],
          "input": { "into": "reactivateReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "reactivateReview.rejectedBy": "user.Name", "reactivateReview.decidedAt": "now" } } },
        { "key": "withdraw-reactivate", "title": "Talebi geri çek", "target": "inactive" }
      ]
    },
    {
      "key": "reactivating", "title": "Kayıt etkinleştiriliyor",
      "onEntry": [ { "task": "bike-set-active", "config": { "entity": "customer", "id": "{{ data.customerId }}", "active": true } } ],
      "transitions": [
        { "key": "reactivate-failed", "target": "not-found", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "reactivated", "target": "loading", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "not-found", "title": "Kayıt bulunamadı", "step": 5, "type": "Finish", "subType": "Error" },
    { "key": "rejected", "title": "Reddedildi", "step": 5, "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "customer", "person", "company", "contact", "verification", "fix" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
