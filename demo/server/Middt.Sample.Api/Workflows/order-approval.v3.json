{
  // v3 (7/8 of the bike store chain): a registered customer (customer-onboarding) → store, product, quantity, delivery →
  // db-query + set (amount = list price × quantity) → credit check → finance / manager / express review or auto
  // approval → entity-create (orders + order_items, status 1) → starts order-fulfillment. Rejected: no order.
  // Instances started with v1 / v2 keep running on order-approval.json / order-approval.v2.json.
  // Data keys read by the order views: orderId, customerName, customerType, email, amount, product, deliveryType, note,
  // requestedBy, requestedAt, credit.*, review.*.
  "key": "order-approval",
  "version": 3,
  "title": "Sipariş onayı",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "timeout": { "after": "P7D", "target": "expired" },
  "start": {
    "key": "start",
    "target": "customer",
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "customer", "title": "Müşteri", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit-customer", "title": "Devam", "target": "order-details", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "customerId", "customerType" ],
            "properties": {
              "customerId": { "type": "integer", "minimum": 1, "title": "Müşteri (kayıtlı)",
                              "x-lookup": { "entity": "Customer", "valueField": "customerId", "textField": "name" } },
              "customerType": { "type": "string", "enum": [ "Bireysel", "Kurumsal" ], "title": "Müşteri tipi" }
            } } }
        }
      ]
    },
    {
      "key": "order-details", "title": "Sipariş detayları", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "submit-order", "title": "Siparişi gönder", "target": "pricing", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "storeId", "productId", "quantity", "deliveryType" ],
            "properties": {
              "storeId": { "type": "integer", "minimum": 1, "title": "Mağaza",
                           "x-lookup": { "entity": "Store", "valueField": "storeId", "textField": "storeName" } },
              "productId": { "type": "integer", "minimum": 1, "title": "Ürün",
                             "x-lookup": { "entity": "Product", "valueField": "productId", "textField": "productName" } },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1, "title": "Adet" },
              "deliveryType": { "type": "string", "enum": [ "Standart", "Ekspres" ], "title": "Teslimat" },
              "note": { "type": "string", "maxLength": 500, "title": "Not" }
            } } }
        },
        { "key": "back", "title": "Geri", "target": "customer" }
      ]
    },
    {
      "key": "pricing", "title": "Fiyatlandırma",
      "onEntry": [
        { "task": "db-query", "config": {
          "sql": "SELECT c.first_name AS firstName, c.last_name AS lastName, c.email AS email, c.active AS customerActive, p.product_name AS product, p.list_price AS listPrice, p.active AS productActive, s.store_name AS storeName, s.active AS storeActive FROM customers c CROSS JOIN products p CROSS JOIN stores s WHERE c.customer_id = {0} AND p.product_id = {1} AND s.store_id = {2}",
          "parameters": ["{{ data.customerId }}", "{{ data.productId }}", "{{ data.storeId }}"], "into": "orderInfo" } },
        { "task": "set", "when": "data.orderInfo[0] == null", "config": { "values": { "error": "\"Seçilen müşteri, ürün veya mağaza bulunamadı ya da pasif durumda.\"" } } },
        { "task": "set", "when": "data.orderInfo[0] != null && data.orderInfo[0].customerActive == 0", "config": { "values": {
          "error": "\"Müşteri \" + data.orderInfo[0].firstName + \" \" + data.orderInfo[0].lastName + \" pasif durumda.\"" } } },
        { "task": "set", "when": "data.orderInfo[0] != null && data.orderInfo[0].customerActive != 0 && data.orderInfo[0].productActive == 0", "config": { "values": {
          "error": "\"\\\"\" + data.orderInfo[0].product + \"\\\" ürünü pasif durumda.\"" } } },
        { "task": "set", "when": "data.orderInfo[0] != null && data.orderInfo[0].customerActive != 0 && data.orderInfo[0].productActive != 0 && data.orderInfo[0].storeActive == 0", "config": { "values": {
          "error": "data.orderInfo[0].storeName + \" mağazası pasif durumda.\"" } } },
        { "task": "set", "when": "data.orderInfo[0] != null && data.orderInfo[0].customerActive != 0 && data.orderInfo[0].productActive != 0 && data.orderInfo[0].storeActive != 0", "config": { "values": {
          "error": "null", "customerName": "data.orderInfo[0].firstName + \" \" + data.orderInfo[0].lastName",
          "email": "data.orderInfo[0].email", "product": "data.orderInfo[0].product",
          "storeName": "data.orderInfo[0].storeName", "listPrice": "data.orderInfo[0].listPrice",
          "amount": "data.orderInfo[0].listPrice * data.quantity" } } }
      ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "priced", "target": "credit-check", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 2, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Siparişi düzelt", "target": "order-details", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "credit-check", "title": "Kredi kontrolü", "type": "SubFlow",
      "subFlow": {
        "workflow": "credit-check",
        "input": { "customerName": "data.customerName", "customerType": "data.customerType", "amount": "data.amount" },
        "outputInto": "credit"
      },
      "transitions": [
        { "key": "credit-ok", "target": "routing", "trigger": "Automatic", "rule": "child.subType == \"Success\"" },
        { "key": "credit-declined", "target": "rejected", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "routing", "title": "Yönlendirme",
      "transitions": [
        { "key": "to-finance", "target": "finance-review", "trigger": "Automatic", "rule": "data.customerType == \"Kurumsal\" && data.amount > 20000" },
        { "key": "to-manager", "target": "manager-review", "trigger": "Automatic", "rule": "data.amount > 5000" },
        { "key": "to-express", "target": "express-review", "trigger": "Automatic", "rule": "data.deliveryType == \"Ekspres\"" },
        { "key": "auto-approve", "target": "creating-order", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "finance-review", "title": "Finans onayı", "step": 3, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating-order", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now", "review.level": "\"finance\"" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } }
      ]
    },
    {
      "key": "manager-review", "title": "Yönetici onayı", "step": 3, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating-order", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "escalate", "target": "escalated", "trigger": "Scheduled", "after": "00:02:00" }
      ]
    },
    {
      "key": "escalated", "title": "Eskale edildi", "step": 3, "subType": "Human", "view": { "layout": "order-escalated" },
      "onEntry": [ { "task": "log", "config": { "message": "Order request of {{ data.customerName }} ({{ data.amount }}) escalated: no decision within 2 minutes", "level": "Warning" } } ],
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating-order", "roles": [ "manager" ],
          "input": { "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } }
      ]
    },
    {
      "key": "express-review", "title": "Ekspres teslimat onayı", "step": 3, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "confirm-express", "title": "Ekspresi onayla", "target": "creating-order", "roles": [ "manager" ],
          "input": { "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "to-standard", "title": "Standart teslimata çevir", "target": "creating-order", "roles": [ "manager" ],
          "input": { "set": { "deliveryType": "\"Standart\"", "review.changedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "auto-confirm", "target": "creating-order", "trigger": "Scheduled", "after": "00:01:00" }
      ]
    },
    {
      "key": "creating-order", "title": "Sipariş oluşturuluyor",
      "onEntry": [
        { "task": "db-query", "config": {
          "sql": "SELECT COALESCE(MIN(CASE WHEN manager_id IS NULL THEN staff_id END), MIN(staff_id)) FROM staffs WHERE store_id = {0} AND active = 1",
          "parameters": ["{{ data.storeId }}"], "singleValue": true, "into": "staffId" } },
        { "task": "set", "when": "data.staffId == null", "config": { "values": { "error": "data.storeName + \" mağazasında aktif personel yok: önce personel alımı akışıyla personel ekleyin.\"" } } },
        { "task": "entity-create", "when": "data.error == null", "config": {
          "entity": "Order", "into": "orderId", "values": {
            "CustomerId": "{{ data.customerId }}", "StoreId": "{{ data.storeId }}", "StaffId": "{{ data.staffId }}",
            "OrderStatus": 1, "OrderDate": "{{ data.requestedAt }}", "RequiredDate": "{{ data.requestedAt }}"
          },
          "dateOffsets": { "RequiredDate": "{{ data.deliveryType == \"Ekspres\" ? 2 : 7 }}" },
          "children": { "OrderItems": [ { "ItemId": 1, "ProductId": "{{ data.productId }}",
            "Quantity": "{{ data.quantity }}", "ListPrice": "{{ data.listPrice }}", "Discount": 0 } ] }
        } }
      ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "created", "target": "approved", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "approved", "title": "Onaylandı", "step": 4, "type": "Finish", "subType": "Success", "view": { "component": "order-result" },
      "onEntry": [
        { "task": "set", "config": { "values": { "approvedAt": "now" } } },
        { "task": "publish", "key": "notify-approved",
          "config": { "type": "OrderApproved", "payload": { "orderId": "{{ data.orderId }}", "amount": "{{ data.amount }}", "customer": "{{ data.customerName }}" } },
          "onError": { "maxAttempts": 3, "delay": "00:00:01", "action": "Continue" } },
        // Next link: stock reservation, picking, shipping and delivery of the new order.
        { "task": "startWorkflow", "key": "start-fulfillment",
          "config": { "workflow": "order-fulfillment", "key": "order-{{ data.orderId }}",
                      "data": { "orderId": "{{ data.orderId }}", "customerName": "{{ data.customerName }}", "storeId": "{{ data.storeId }}",
                                "storeName": "{{ data.storeName }}", "productId": "{{ data.productId }}", "product": "{{ data.product }}",
                                "quantity": "{{ data.quantity }}", "amount": "{{ data.amount }}", "deliveryType": "{{ data.deliveryType }}" },
                      "into": "fulfillmentId" } }
      ]
    },
    { "key": "rejected", "title": "Reddedildi", "step": 4, "type": "Finish", "subType": "Error", "view": { "component": "order-result" },
      "onEntry": [ { "task": "log", "config": { "message": "Order request of {{ data.customerName }} ({{ data.amount }}) rejected: no order created" } } ] },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" },
    { "key": "expired", "title": "Süresi doldu", "type": "Finish", "subType": "Timeout" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "*" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
