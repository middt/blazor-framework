{
  // v2 (wizard): customer → company | person → order details → credit check → finance / manager / express review or auto approval.
  // New instances use v2; instances started with v1 keep running on order-approval.json.
  "key": "order-approval",
  "version": 2,
  "title": "Sipariş onayı",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "timeout": { "after": "P7D", "target": "expired" },
  "start": {
    "key": "start",
    "target": "customer",
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "customer", "title": "Müşteri bilgileri", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit-customer", "title": "Devam", "target": "customer-routing", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "customerType", "customerName", "email" ],
            "properties": {
              "customerType": { "type": "string", "enum": [ "Bireysel", "Kurumsal" ], "title": "Müşteri tipi" },
              "customerName": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Müşteri adı / unvanı" },
              "email": { "type": "string", "format": "email", "maxLength": 200, "title": "E-posta" }
            } } }
        }
      ]
    },
    {
      "key": "customer-routing", "title": "Müşteri tipi kontrolü",
      "transitions": [
        { "key": "to-company", "target": "company", "trigger": "Automatic", "rule": "data.customerType == \"Kurumsal\"" },
        { "key": "to-person", "target": "person", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "company", "title": "Firma bilgileri", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "submit-company", "title": "Devam", "target": "order-details", "view": { "inline": true },
          "input": { "into": "company", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "taxNumber", "taxOffice" ],
            "properties": {
              "taxNumber": { "type": "string", "pattern": "^[0-9]{10}$", "title": "Vergi numarası (10 hane)" },
              "taxOffice": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Vergi dairesi" },
              "contactPerson": { "type": "string", "maxLength": 100, "title": "Yetkili kişi" }
            } } }
        },
        { "key": "back", "title": "Geri", "target": "customer" }
      ]
    },
    {
      "key": "person", "title": "Kimlik bilgileri", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "submit-person", "title": "Devam", "target": "order-details", "view": { "inline": true },
          "input": { "into": "person", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "identityNumber", "birthDate" ],
            "properties": {
              "identityNumber": { "type": "string", "pattern": "^[1-9][0-9]{10}$", "title": "T.C. kimlik no (11 hane)" },
              "birthDate": { "type": "string", "format": "date-time", "title": "Doğum tarihi" },
              "phone": { "type": "string", "pattern": "^\\+?[0-9 ]{10,15}$", "title": "Telefon" }
            } } }
        },
        { "key": "back", "title": "Geri", "target": "customer" }
      ]
    },
    {
      "key": "order-details", "title": "Sipariş detayları", "step": 3, "subType": "Human",
      "transitions": [
        {
          "key": "submit-order", "title": "Siparişi gönder", "target": "credit-check", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "orderId", "product", "amount", "deliveryType" ],
            "properties": {
              "orderId": { "type": "integer", "minimum": 1, "title": "Sipariş no" },
              "product": { "type": "string", "enum": [ "Bisiklet", "Ekipman", "Yedek parça" ], "title": "Ürün grubu" },
              "amount": { "type": "number", "minimum": 1, "title": "Tutar (TL)" },
              "deliveryType": { "type": "string", "enum": [ "Standart", "Ekspres" ], "title": "Teslimat" },
              "note": { "type": "string", "maxLength": 500, "title": "Not" }
            } } }
        },
        // Conditional manual transitions: only one "Geri" is offered, depending on the customer type.
        { "key": "back-company", "title": "Geri", "target": "company", "rule": "data.customerType == \"Kurumsal\"" },
        { "key": "back-person", "title": "Geri", "target": "person", "rule": "data.customerType != \"Kurumsal\"" }
      ]
    },
    {
      "key": "credit-check", "title": "Kredi kontrolü", "type": "SubFlow",
      "subFlow": {
        "workflow": "credit-check",
        "input": { "customerName": "data.customerName", "customerType": "data.customerType", "amount": "data.amount" },
        "outputInto": "credit"
      },
      "transitions": [
        { "key": "credit-ok", "target": "routing", "trigger": "Automatic", "rule": "child.subType == \"Success\"" },
        { "key": "credit-declined", "target": "rejected", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "routing", "title": "Yönlendirme",
      "transitions": [
        { "key": "to-finance", "target": "finance-review", "trigger": "Automatic", "rule": "data.customerType == \"Kurumsal\" && data.amount > 20000" },
        { "key": "to-manager", "target": "manager-review", "trigger": "Automatic", "rule": "data.amount > 5000" },
        { "key": "to-express", "target": "express-review", "trigger": "Automatic", "rule": "data.deliveryType == \"Ekspres\"" },
        { "key": "auto-approve", "target": "approved", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "finance-review", "title": "Finans onayı", "step": 4, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "approved", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now", "review.level": "\"finance\"" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } }
      ]
    },
    {
      "key": "manager-review", "title": "Yönetici onayı", "step": 4, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "approved", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "escalate", "target": "escalated", "trigger": "Scheduled", "after": "00:02:00" }
      ]
    },
    {
      "key": "escalated", "title": "Eskale edildi", "step": 4, "subType": "Human", "view": { "layout": "order-escalated" },
      "onEntry": [ { "task": "log", "config": { "message": "Order {{ data.orderId }} escalated: no decision within 2 minutes", "level": "Warning" } } ],
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "approved", "roles": [ "manager" ] },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ], "view": { "component": "reject-reason" },
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } }
      ]
    },
    {
      "key": "express-review", "title": "Ekspres teslimat onayı", "step": 4, "subType": "Human", "view": { "component": "order-review" },
      "transitions": [
        { "key": "confirm-express", "title": "Ekspresi onayla", "target": "approved", "roles": [ "manager" ] },
        { "key": "to-standard", "title": "Standart teslimata çevir", "target": "approved", "roles": [ "manager" ],
          "input": { "set": { "deliveryType": "\"Standart\"", "review.changedBy": "user.Name" } } },
        { "key": "auto-confirm", "target": "approved", "trigger": "Scheduled", "after": "00:01:00" }
      ]
    },
    {
      "key": "approved", "title": "Onaylandı", "step": 5, "type": "Finish", "subType": "Success", "view": { "component": "order-result" },
      "onEntry": [
        { "task": "set", "config": { "values": { "approvedAt": "now" } } },
        { "task": "publish", "key": "notify-approved",
          "config": { "type": "OrderApproved", "payload": { "orderId": "{{ data.orderId }}", "amount": "{{ data.amount }}", "customer": "{{ data.customerName }}" } },
          "onError": { "maxAttempts": 3, "delay": "00:00:01", "action": "Continue" } }
      ]
    },
    { "key": "rejected", "title": "Reddedildi", "step": 5, "type": "Finish", "subType": "Error", "view": { "component": "order-result" },
      "onEntry": [ { "task": "log", "config": { "message": "Order {{ data.orderId }} rejected" } } ] },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" },
    { "key": "expired", "title": "Süresi doldu", "type": "Finish", "subType": "Timeout" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "*" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
