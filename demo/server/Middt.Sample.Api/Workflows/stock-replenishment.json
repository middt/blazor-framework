{
  // 5/8: store + product + quantity → manager approval (automatic after 1 minute; immediately when the order-fulfillment
  // workflow asks for the missing quantity) → bike-adjust-stock (+quantity, stocks table).
  // Started with data { storeId, productId, quantity, requestedBy } by product-launch (initial stock) and as a subflow
  // of order-fulfillment: the form step is skipped.
  "key": "stock-replenishment",
  "version": 1,
  "title": "Stok ikmali",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": {
    "key": "start",
    "target": "entry",
    "onExecute": [
      { "task": "set", "when": "data.requestedBy == null", "config": { "values": { "requestedBy": "user.Name" } } },
      { "task": "set", "config": { "values": { "requestedAt": "now" } } }
    ]
  },
  "states": [
    {
      "key": "entry", "title": "Başlangıç",
      "transitions": [
        { "key": "prefilled", "target": "approval-routing", "trigger": "Automatic", "rule": "data.storeId != null && data.productId != null && data.quantity != null" },
        { "key": "ask", "target": "request", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "request", "title": "İkmal talebi", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit", "title": "Onaya gönder", "target": "approval-routing", "view": { "inline": true },
          "input": { "schema": {
            "type": "object", "additionalProperties": false, "required": [ "storeId", "productId", "quantity" ],
            "properties": {
              "storeId": { "type": "integer", "minimum": 1, "title": "Mağaza",
                           "x-lookup": { "entity": "Store", "valueField": "storeId", "textField": "storeName" } },
              "productId": { "type": "integer", "minimum": 1, "title": "Ürün",
                             "x-lookup": { "entity": "Product", "valueField": "productId", "textField": "productName" } },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 1000, "title": "Adet" },
              "note": { "type": "string", "maxLength": 500, "title": "Not" }
            } } }
        }
      ]
    },
    {
      "key": "approval-routing", "title": "Onay kontrolü",
      "transitions": [
        { "key": "auto-for-order", "target": "replenishing", "trigger": "Automatic", "rule": "data.requestedBy == \"order-fulfillment\"",
          "onExecute": [ { "task": "set", "config": { "values": { "review.approvedBy": "\"Otomatik (sipariş karşılama)\"", "review.decidedAt": "now" } } } ] },
        { "key": "to-approval", "target": "approval", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "approval", "title": "Yönetici onayı", "step": 2, "subType": "Human",
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "replenishing", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "back", "title": "Düzenle", "target": "request" },
        { "key": "auto-approve", "target": "replenishing", "trigger": "Scheduled", "after": "00:01:00",
          "onExecute": [ { "task": "set", "config": { "values": { "review.approvedBy": "\"Otomatik onay (1 dakika)\"", "review.decidedAt": "now" } } } ] }
      ]
    },
    {
      "key": "replenishing", "title": "Stok güncelleniyor",
      "onEntry": [ { "task": "bike-adjust-stock", "config": {
        "storeId": "{{ data.storeId }}", "productId": "{{ data.productId }}", "quantity": "{{ data.quantity }}", "operation": "replenishedStock" } } ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "done", "target": "completed", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 2, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Bilgileri düzelt", "target": "request", "input": { "set": { "error": "null" } } } ]
    },
    { "key": "completed", "title": "Stok eklendi", "step": 3, "type": "Finish", "subType": "Success" },
    { "key": "rejected", "title": "Reddedildi", "step": 3, "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "request", "approval", "fix" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
