{
  // 8/8: started by order-approval with data { orderId, storeId, productId, quantity, customerName, product, … }.
  // bike-check-stock → missing stock: stock-replenishment subflow for the missing quantity, then check again → enough:
  // bike-adjust-stock (−quantity, reserved) → order status 2 → picking → shipping (carrier, tracking no, shipped date)
  // → delivered (button or automatically after 3 minutes) → order status 4. Cancel: reserved stock back, status 3.
  "key": "order-fulfillment",
  "version": 1,
  "title": "Sipariş karşılama",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": { "key": "start", "target": "entry" },
  "states": [
    {
      "key": "entry", "title": "Başlangıç",
      "transitions": [
        { "key": "has-order", "target": "stock-check", "trigger": "Automatic", "rule": "data.orderId != null" },
        { "key": "no-order", "target": "invalid", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "stock-check", "title": "Stok kontrolü",
      "onEntry": [ { "task": "bike-check-stock", "config": {
        "storeId": "{{ data.storeId }}", "productId": "{{ data.productId }}", "quantity": "{{ data.quantity }}", "into": "stockCheck" } } ],
      "transitions": [
        { "key": "check-failed", "target": "stock-problem", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "enough", "target": "reserving", "trigger": "Automatic", "rule": "data.stockCheck.enough == true" },
        { "key": "missing", "target": "replenishment", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "replenishment", "title": "Stok ikmali bekleniyor", "type": "SubFlow",
      "subFlow": {
        "workflow": "stock-replenishment",
        "input": { "storeId": "data.storeId", "productId": "data.productId", "quantity": "data.stockCheck.missing",
                   "requestedBy": "\"order-fulfillment\"", "orderId": "data.orderId" },
        "outputInto": "replenishment"
      },
      "transitions": [
        { "key": "replenished", "target": "stock-check", "trigger": "Automatic", "rule": "child.subType == \"Success\"" },
        { "key": "not-replenished", "target": "stock-problem", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "error": "\"Stok ikmali onaylanmadı ya da iptal edildi.\"" } } } ] },
        // While the subflow runs only a transition to a final state is allowed (nothing is reserved yet).
        { "key": "cancel", "title": "Siparişi iptal et", "target": "cancelled", "roles": [ "manager" ],
          "input": {
            "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
            "into": "cancellation",
            "set": { "cancellation.by": "user.Name" }
          } }
      ]
    },
    {
      "key": "stock-problem", "title": "Stok sağlanamadı", "step": 1, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "retry-stock", "title": "Stoğu tekrar kontrol et", "target": "stock-check", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "reserving", "title": "Stok ayrılıyor",
      "onEntry": [ { "task": "bike-adjust-stock", "config": {
        "storeId": "{{ data.storeId }}", "productId": "{{ data.productId }}", "quantity": "{{ -data.quantity }}", "operation": "reservedStock" } } ],
      "transitions": [
        // Someone else took the stock between the check and the reservation: check (and replenish) again.
        { "key": "reserve-failed", "target": "stock-check", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "reserved", "target": "picking", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "picking", "title": "Hazırlanıyor", "step": 1, "subType": "Human",
      "onEntry": [ { "task": "bike-set-order-status", "config": { "orderId": "{{ data.orderId }}", "status": 2 } } ],
      "transitions": [
        { "key": "picked", "title": "Hazırlandı", "target": "shipping",
          "input": { "set": { "pickedBy": "user.Name", "pickedAt": "now" } } }
      ]
    },
    {
      "key": "shipping", "title": "Kargoya verilecek", "step": 2, "subType": "Human",
      "transitions": [
        {
          "key": "ship", "title": "Kargoya ver", "target": "in-transit", "view": { "inline": true },
          "input": { "into": "shipment", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "carrier" ],
            "properties": {
              "carrier": { "type": "string", "enum": [ "Yurtiçi Kargo", "Aras Kargo", "MNG Kargo", "Mağaza teslim" ], "title": "Kargo firması" },
              "trackingNumber": { "type": "string", "pattern": "^[A-Za-z0-9-]{4,30}$", "title": "Takip numarası" }
            } },
            "set": { "shipment.shippedBy": "user.Name", "shipment.shippedAt": "now" } }
        }
      ]
    },
    {
      "key": "in-transit", "title": "Yolda", "step": 3, "subType": "Human",
      "onEntry": [ { "task": "bike-set-order-status", "config": { "orderId": "{{ data.orderId }}", "status": 2, "shipped": true } } ],
      "transitions": [
        { "key": "deliver", "title": "Teslim edildi", "target": "delivering", "input": { "set": { "deliveredBy": "user.Name" } } },
        { "key": "auto-deliver", "target": "delivering", "trigger": "Scheduled", "after": "00:03:00",
          "onExecute": [ { "task": "set", "config": { "values": { "deliveredBy": "\"Otomatik (kargo bildirimi)\"" } } } ] }
      ]
    },
    {
      "key": "delivering", "title": "Teslim kaydediliyor",
      "onEntry": [ { "task": "bike-set-order-status", "config": { "orderId": "{{ data.orderId }}", "status": 4, "shipped": true } } ],
      "transitions": [ { "key": "completed", "target": "delivered", "trigger": "Automatic", "default": true } ]
    },
    {
      "key": "cancelling", "title": "İptal ediliyor",
      "onEntry": [
        // Return the reserved stock (marker: releasedStock), then mark the order rejected/cancelled (status 3).
        { "task": "bike-adjust-stock", "when": "data.reservedStock != null", "config": {
          "storeId": "{{ data.storeId }}", "productId": "{{ data.productId }}", "quantity": "{{ data.quantity }}", "operation": "releasedStock" } }
      ],
      "transitions": [ { "key": "released", "target": "cancelled", "trigger": "Automatic", "default": true } ]
    },
    { "key": "delivered", "title": "Teslim edildi", "step": 4, "type": "Finish", "subType": "Success",
      "onEntry": [ { "task": "set", "config": { "values": { "deliveredAt": "now" } } } ] },
    { "key": "invalid", "title": "Sipariş bilgisi yok", "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled",
      "onEntry": [ { "task": "bike-set-order-status", "config": { "orderId": "{{ data.orderId }}", "status": 3 } } ] }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "Siparişi iptal et", "target": "cancelling", "availableIn": [ "stock-problem", "picking", "shipping" ],
      "roles": [ "manager" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
