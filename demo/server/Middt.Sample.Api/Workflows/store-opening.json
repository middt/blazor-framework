{
  // 1/8 of the bike store chain: store details → manager approval → bike-create-store (stores table) → starts
  // staff-onboarding for the new store (store pre-selected). Rule violations (duplicate name) go to "fix".
  "key": "store-opening",
  "version": 1,
  "title": "Mağaza açılışı",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": {
    "key": "start",
    "target": "details",
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "details", "title": "Mağaza bilgileri", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit", "title": "Onaya gönder", "target": "approval", "view": { "inline": true },
          "input": { "into": "store", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "storeName", "city" ],
            "properties": {
              "storeName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Mağaza adı" },
              "phone": { "type": "string", "pattern": "^\\+?[0-9 ()-]{7,25}$", "maxLength": 25, "title": "Telefon" },
              "email": { "type": "string", "format": "email", "maxLength": 255, "title": "E-posta" },
              "street": { "type": "string", "maxLength": 255, "title": "Adres" },
              "city": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Şehir" },
              "state": { "type": "string", "maxLength": 10, "title": "İl kodu / eyalet" },
              "zipCode": { "type": "string", "pattern": "^[0-9]{5}$", "title": "Posta kodu" }
            } } }
        }
      ]
    },
    {
      "key": "approval", "title": "Yönetici onayı", "step": 2, "subType": "Human",
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "back", "title": "Düzenle", "target": "details" }
      ]
    },
    {
      "key": "creating", "title": "Mağaza oluşturuluyor",
      "onEntry": [ { "task": "bike-create-store", "config": {
        "storeName": "{{ data.store.storeName }}", "phone": "{{ data.store.phone }}", "email": "{{ data.store.email }}",
        "street": "{{ data.store.street }}", "city": "{{ data.store.city }}", "state": "{{ data.store.state }}",
        "zipCode": "{{ data.store.zipCode }}", "into": "storeId" } } ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "created", "target": "opened", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 2, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Bilgileri düzelt", "target": "details", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "opened", "title": "Mağaza açıldı", "step": 3, "type": "Finish", "subType": "Success",
      "onEntry": [
        { "task": "set", "config": { "values": { "openedAt": "now" } } },
        // Next link of the chain: hire the first staff member of the new store. Kept for running v1 instances, adapted
        // to staff-onboarding v2 (start input { storeId }; the child sets its own key "staff-<id>").
        { "task": "startWorkflow", "key": "start-staff-onboarding", "when": "data.staffOnboardingId == null",
          "config": { "workflow": "staff-onboarding", "data": { "storeId": "{{ data.storeId }}" }, "into": "staffOnboardingId" } }
      ]
    },
    { "key": "rejected", "title": "Reddedildi", "step": 3, "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "details", "approval", "fix" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
