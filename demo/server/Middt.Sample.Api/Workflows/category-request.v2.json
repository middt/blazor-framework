{
  // 3/8 and the lifecycle of a category (one instance per category, business key "category-<id>"): category name +
  // justification → manager approval → bike-create-category (categories table, publishes CategoryCreated) → "active":
  // rename requests (bike-update-category) and the close request (bike-set-active false; refused while the category has
  // active products). Started with a categoryId it adopts that category. Reject → Error; duplicate name → "fix".
  "key": "category-request",
  "version": 2,
  "title": "Kategori talebi",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": {
    "key": "start",
    "target": "entry",
    // Optional: an existing record (adoption). The UI starts with business key "<entity>-<id>" and this id, so an
    // existing lifecycle instance of the record is returned instead of a new one.
    "input": { "schema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "categoryId": { "type": "integer", "minimum": 1, "title": "Mevcut kayıt (yeni kayıt için boş bırakın)",
                      "x-lookup": { "entity": "Category", "valueField": "categoryId", "textField": "categoryName" } }
      } } },
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "entry", "title": "Başlangıç",
      "transitions": [
        { "key": "adopt", "target": "loading", "trigger": "Automatic", "rule": "data.categoryId != null",
          "onExecute": [ { "task": "set", "config": { "values": { "adoptedAt": "now" } } } ] },
        { "key": "new", "target": "request", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "request", "title": "Talep", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit", "title": "Onaya gönder", "target": "approval", "view": { "inline": true },
          "input": { "into": "category", "schema": {
            "type": "object", "additionalProperties": false, "required": [ "categoryName", "justification" ],
            "properties": {
              "categoryName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Kategori adı" },
              "justification": { "type": "string", "minLength": 5, "maxLength": 500, "title": "Gerekçe" }
            } } }
        }
      ]
    },
    {
      "key": "approval", "title": "Yönetici onayı", "step": 2, "subType": "Human",
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "back", "title": "Düzenle", "target": "request" }
      ]
    },
    {
      "key": "creating", "title": "Kategori oluşturuluyor",
      "onEntry": [ { "task": "bike-create-category", "config": { "categoryName": "{{ data.category.categoryName }}", "into": "categoryId" } } ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        // data.category is replaced by the stored record: the justification is kept next to it.
        { "key": "created", "target": "loading", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "justification": "data.category.justification", "createdAt": "now" } } } ] }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 2, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Bilgileri düzelt", "target": "request", "input": { "set": { "error": "null" } } } ]
    },
    // ───────────── lifecycle: one instance per record (business key "category-<id>"), closing = deactivating ─────────────
    {
      // Reached after the create task, after every approved change and when an existing record is adopted.
      "key": "loading", "title": "Kayıt yükleniyor",
      "onEntry": [
        { "task": "bike-load-record", "config": { "entity": "category", "id": "{{ data.categoryId }}", "into": "category" } },
        { "task": "setKey", "when": "data.error == null", "config": { "key": "category-{{ data.categoryId }}" } },
        // Prefill of the change request form: the current values.
        { "task": "set", "when": "data.error == null", "config": { "values": { "change": "data.category" } } }
      ],
      "transitions": [
        { "key": "load-failed", "target": "not-found", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "to-inactive", "target": "inactive", "trigger": "Automatic", "rule": "data.category.active == false" },
        { "key": "to-active", "target": "active", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "active", "title": "Aktif", "step": 3, "subType": "Human",
      "transitions": [
        {
          "key": "request-change", "title": "Değişiklik talebi", "target": "change-approval", "view": { "inline": true },
          "input": { "into": "change", "schema": {
              "type": "object", "additionalProperties": false, "required": [ "categoryName" ],
              "properties": {
                "categoryName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Kategori adı" }
              } },
            // The request replaces data.change (a cleared optional field is removed, not kept from the prefill).
            "set": { "change": "input", "changeRequest.by": "user.Name", "changeRequest.at": "now", "changeReview": "null" } }
        },
        {
          "key": "request-close", "title": "Kapatma talebi", "target": "close-approval",
          "input": { "into": "closeRequest", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Kapatma nedeni" } } },
            "set": { "closeRequest.by": "user.Name", "closeRequest.at": "now", "closeReview": "null" } }
        }
      ]
    },
    {
      "key": "change-approval", "title": "Değişiklik onayı", "step": 3, "subType": "Human",
      "transitions": [
        { "key": "approve-change", "title": "Onayla", "target": "updating", "roles": [ "manager" ],
          "input": { "into": "changeReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "changeReview.approvedBy": "user.Name", "changeReview.decidedAt": "now" } } },
        // Rejected: the record keeps its values, the form is prefilled with them again.
        { "key": "reject-change", "title": "Reddet", "target": "active", "roles": [ "manager" ],
          "input": { "into": "changeReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "changeReview.rejectedBy": "user.Name", "changeReview.decidedAt": "now", "change": "data.category" } } },
        { "key": "withdraw-change", "title": "Talebi geri çek", "target": "active", "input": { "set": { "change": "data.category" } } }
      ]
    },
    {
      "key": "updating", "title": "Değişiklik kaydediliyor",
      "onEntry": [ { "task": "bike-update-category", "config": { "id": "{{ data.categoryId }}", "categoryName": "{{ data.change.categoryName }}" } } ],
      "transitions": [
        { "key": "update-failed", "target": "change-fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "updated", "target": "loading", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "changedAt": "now" } } } ] }
      ]
    },
    {
      // Rule violation of a change or close (duplicate name, category with active products …): back to the record,
      // a change request form is prefilled with the values just tried.
      "key": "change-fix", "title": "Düzeltme gerekli", "step": 3, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "back-to-record", "title": "Kayda dön", "target": "active", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "close-approval", "title": "Kapatma onayı", "step": 3, "subType": "Human",
      "transitions": [
        { "key": "approve-close", "title": "Onayla", "target": "closing", "roles": [ "manager" ],
          "input": { "into": "closeReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "closeReview.approvedBy": "user.Name", "closeReview.decidedAt": "now" } } },
        { "key": "reject-close", "title": "Reddet", "target": "active", "roles": [ "manager" ],
          "input": { "into": "closeReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "closeReview.rejectedBy": "user.Name", "closeReview.decidedAt": "now" } } },
        { "key": "withdraw-close", "title": "Talebi geri çek", "target": "active" }
      ]
    },
    {
      // Soft delete: the record stays (orders keep referencing it) but is no longer offered in lookups.
      "key": "closing", "title": "Kayıt kapatılıyor",
      "onEntry": [ { "task": "bike-set-active", "config": { "entity": "category", "id": "{{ data.categoryId }}", "active": false } } ],
      "transitions": [
        { "key": "close-failed", "target": "change-fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "deactivated", "target": "closed", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "closed", "title": "Kapatıldı", "step": 3, "type": "Finish", "subType": "Success",
      "onEntry": [ { "task": "set", "config": { "values": { "closedAt": "now", "category.active": "false" } } } ] },
    {
      // An adopted record that was already passive (closed before the lifecycle existed).
      "key": "inactive", "title": "Pasif", "step": 3, "subType": "Human",
      "transitions": [
        { "key": "request-reactivate", "title": "Yeniden etkinleştirme talebi", "target": "reactivate-approval",
          "input": { "into": "reactivateRequest", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Gerekçe" } } },
            "set": { "reactivateRequest.by": "user.Name", "reactivateRequest.at": "now", "reactivateReview": "null" } } }
      ]
    },
    {
      "key": "reactivate-approval", "title": "Etkinleştirme onayı", "step": 3, "subType": "Human",
      "transitions": [
        { "key": "approve-reactivate", "title": "Onayla", "target": "reactivating", "roles": [ "manager" ],
          "input": { "into": "reactivateReview", "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "reactivateReview.approvedBy": "user.Name", "reactivateReview.decidedAt": "now" } } },
        { "key": "reject-reactivate", "title": "Reddet", "target": "inactive", "roles": [ "manager" ],
          "input": { "into": "reactivateReview", "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "reactivateReview.rejectedBy": "user.Name", "reactivateReview.decidedAt": "now" } } },
        { "key": "withdraw-reactivate", "title": "Talebi geri çek", "target": "inactive" }
      ]
    },
    {
      "key": "reactivating", "title": "Kayıt etkinleştiriliyor",
      "onEntry": [ { "task": "bike-set-active", "config": { "entity": "category", "id": "{{ data.categoryId }}", "active": true } } ],
      "transitions": [
        { "key": "reactivate-failed", "target": "not-found", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "reactivated", "target": "loading", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "not-found", "title": "Kayıt bulunamadı", "step": 3, "type": "Finish", "subType": "Error" },
    { "key": "rejected", "title": "Reddedildi", "step": 3, "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "request", "approval", "fix" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
