{
  // A deliberately invalid read fails twice, then onError Continue lets the next general task run.
  // No database write or external side effect is involved.
  "key": "test-retry-tasks",
  "version": 1,
  "title": "Yeniden Deneme ve Hata Politikası Testi",
  "start": { "key": "start", "target": "ready" },
  "states": [
    {
      "key": "ready",
      "title": "Hazır",
      "subType": "Human",
      "transitions": [
        {
          "key": "run",
          "title": "Görevi çalıştır",
          "target": "completed",
          "onExecute": [
            {
              "task": "db-query",
              "key": "retry-once",
              "config": { "sql": "SELECT value FROM middt_retry_demo_missing_table", "into": "unused" },
              "onError": { "maxAttempts": 2, "delay": "00:00:00", "action": "Continue" }
            },
            { "task": "set", "config": { "values": { "retryPolicyOutcome": "\"İki başarısız denemeden sonra devam edildi.\"" } } }
          ]
        }
      ]
    },
    { "key": "completed", "title": "Tamamlandı", "type": "Finish", "subType": "Success" }
  ]
}
