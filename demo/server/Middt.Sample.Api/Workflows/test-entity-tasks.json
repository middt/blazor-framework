{
  // Demonstrates generic tasks by creating and deleting a brand. For durable business writes use an idempotent
  // application task or a unique business key: the workflow transaction cannot roll back an external DbContext.
  "key": "test-entity-tasks",
  "version": 1,
  "title": "Veritabanı ve Entity Görevleri Test Akışı",
  "start": {
    "key": "start",
    "target": "insert-brand",
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "brandName": { "type": "string" }
        },
        "required": ["brandName"]
      }
    }
  },
  "states": [
    {
      "key": "insert-brand",
      "title": "Marka Ekle (entity-create)",
      "onEntry": [
        {
          "task": "entity-create",
          "config": {
            "entity": "Brand",
            "values": {
              "BrandName": "{{ data.brandName }}"
            },
            "into": "createdBrandId"
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Yeni marka oluşturuldu. ID: {{ data.createdBrandId }}"
          }
        }
      ],
      "transitions": [
        { "key": "to-load", "target": "load-and-query", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "load-and-query",
      "title": "Kayıt Çekme (entity-load ve db-query)",
      "onEntry": [
        {
          "task": "entity-load",
          "config": {
            "entity": "Brand",
            "id": "{{ data.createdBrandId }}",
            "into": "loadedBrand"
          }
        },
        {
          "task": "db-query",
          "config": {
            "sql": "SELECT brand_name FROM brands WHERE brand_id = {0}",
            "parameters": ["{{ data.createdBrandId }}"],
            "singleValue": true,
            "into": "queriedBrandName"
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Marka yüklendi: {{ data.loadedBrand.BrandName }}, SQL sorgu sonucu: {{ data.queriedBrandName }}"
          }
        }
      ],
      "transitions": [
        { "key": "to-update", "target": "update-brand", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "update-brand",
      "title": "Güncelleme (entity-update ve db-sql)",
      "onEntry": [
        {
          "task": "entity-update",
          "config": {
            "entity": "Brand",
            "id": "{{ data.createdBrandId }}",
            "values": {
              "BrandName": "{{ data.brandName }} (EF Updated)"
            }
          }
        },
        {
          "task": "db-sql",
          "config": {
            "sql": "UPDATE brands SET brand_name = {0} WHERE brand_id = {1}",
            "parameters": ["{{ data.brandName }} (Final SQL)", "{{ data.createdBrandId }}"]
          }
        }
      ],
      "transitions": [
        { "key": "to-delete", "target": "delete-brand", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "delete-brand",
      "title": "Kayıt Silme (entity-delete)",
      "onEntry": [
        {
          "task": "entity-delete",
          "config": {
            "entity": "Brand",
            "id": "{{ data.createdBrandId }}"
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Marka kaydı silindi: {{ data.createdBrandId }}"
          }
        }
      ],
      "transitions": [
        { "key": "to-complete", "target": "completed", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "completed",
      "title": "Tamamlandı",
      "type": "Finish",
      "subType": "Success",
      "onEntry": [
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Entity ve Veritabanı test akışı başarıyla bitti."
          }
        }
      ]
    }
  ]
}
