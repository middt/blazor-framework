{
  // Reusable subflow: queries active staff members for a specific store/branch.
  "key": "get-branch-staff",
  "version": 1,
  "title": "Şube Personel Listesini Getir",
  "start": { "key": "start", "target": "validate" },
  "states": [
    {
      "key": "validate",
      "title": "Girdi Doğrulama",
      "transitions": [
        { "key": "valid", "target": "query", "trigger": "Automatic", "rule": "data.branchId != null && data.branchId > 0" },
        { "key": "invalid", "target": "invalid-branch", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "query",
      "title": "Personel Sorgusu",
      "onEntry": [
        {
          "task": "db-query",
          "config": {
            "sql": "SELECT staff_id AS id, first_name AS firstName, last_name AS lastName, email FROM staffs WHERE store_id = {0} AND active = 1",
            "parameters": [ "{{ data.branchId }}" ],
            "into": "items"
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Şube {{ data.branchId }} personelleri alt akışla veritabanından çekildi."
          }
        }
      ],
      "transitions": [
        { "key": "done", "target": "completed", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "completed", "title": "Başarılı", "type": "Finish", "subType": "Success" },
    { "key": "invalid-branch", "title": "Geçersiz Şube", "type": "Finish", "subType": "Error" }
  ]
}
