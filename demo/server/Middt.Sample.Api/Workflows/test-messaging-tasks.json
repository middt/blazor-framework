{
  "key": "test-messaging-tasks",
  "version": 1,
  "title": "Mesajlaşma Görevleri Test Akışı (RabbitMQ, Rebus, Publish)",
  "start": {
    "key": "start",
    "target": "publish-events",
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" },
          "amount": { "type": "number" }
        },
        "required": ["orderId"]
      }
    }
  },
  "states": [
    {
      "key": "publish-events",
      "title": "Olay Yayınlama (publish, rabbitmq, rebus-publish)",
      "onEntry": [
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Mesajlaşma test akışı başladı. Sipariş ID: {{ data.orderId }}"
          }
        },
        {
          "task": "publish",
          "config": {
            "type": "OrderNotification",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "action": "NotificationPublished"
            }
          }
        },
        {
          "task": "rabbitmq",
          "config": {
            "exchange": "orders.events",
            "routingKey": "order.created.{{ data.orderId }}",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "amount": "{{ data.amount }}"
            },
            "headers": {
              "correlationId": "{{ data.orderId }}"
            },
            "persistent": true,
            "into": "rabbitPublishResult"
          }
        },
        {
          "task": "rebus-publish",
          "config": {
            "topic": "orders/lifecycle",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "status": "Created"
            },
            "into": "rebusPublishResult"
          }
        }
      ],
      "transitions": [
        { "key": "to-queue-ops", "target": "queue-ops", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "queue-ops",
      "title": "Kuyruk Gönderimi (rebus-send, rebus-send-local)",
      "onEntry": [
        {
          "task": "rebus-send",
          "config": {
            "queue": "order-processing",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "command": "ProcessOrder"
            },
            "headers": {
              "source": "Workflow"
            },
            "into": "rebusSendResult"
          }
        },
        {
          "task": "rebus-send-local",
          "config": {
            "payload": {
              "orderId": "{{ data.orderId }}",
              "command": "AuditLocally"
            },
            "into": "rebusSendLocalResult"
          }
        }
      ],
      "transitions": [
        { "key": "to-defer-ops", "target": "defer-ops", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "defer-ops",
      "title": "Gecikmeli Mesajlar (rebus-defer, rebus-defer-local)",
      "onEntry": [
        {
          "task": "rebus-defer",
          "config": {
            "queue": "order-reminders",
            "delay": "00:05:00",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "reminder": "PaymentPending"
            },
            "into": "rebusDeferResult"
          }
        },
        {
          "task": "rebus-defer-local",
          "config": {
            "delay": "00:01:00",
            "payload": {
              "orderId": "{{ data.orderId }}",
              "action": "CheckLocalTimeout"
            },
            "into": "rebusDeferLocalResult"
          }
        }
      ],
      "transitions": [
        { "key": "to-sub-ops", "target": "subscription-ops", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "subscription-ops",
      "title": "Dinamik Abonelik (rebus-subscribe, rebus-unsubscribe)",
      "onEntry": [
        {
          "task": "rebus-subscribe",
          "config": {
            "topic": "orders/payment-completed",
            "into": "rebusSubResult"
          }
        },
        {
          "task": "rebus-unsubscribe",
          "config": {
            "topic": "orders/payment-completed",
            "into": "rebusUnsubResult"
          }
        }
      ],
      "transitions": [
        { "key": "finish", "target": "completed", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "completed",
      "title": "Tamamlandı",
      "type": "Finish",
      "subType": "Success",
      "onEntry": [
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Mesajlaşma test akışı başarıyla tamamlandı. Sipariş: {{ data.orderId }}"
          }
        }
      ]
    }
  ]
}
