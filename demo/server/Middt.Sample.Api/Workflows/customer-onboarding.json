{
  "key": "customer-onboarding",
  "version": 1,
  "title": "Müşteri Kaydı & KYC",
  "icon": "person_add",
  "instanceAccess": {
    "mode": "owner",
    "supervisorRoles": [ "manager" ]
  },
  "dataSchema": {
    "type": "object",
    "properties": {
      "fullName": { "type": "string", "title": "Ad Soyad / Ünvan" },
      "identityNumber": {
        "type": "string",
        "title": "T.C. Kimlik / Vergi No",
        "x-mask": { "pattern": "last4", "exceptRoles": [ "manager", "idp-admin" ] }
      },
      "email": {
        "type": "string",
        "title": "E-posta",
        "x-list": false,
        "x-mask": { "pattern": "email", "exceptRoles": [ "manager", "idp-admin" ] }
      },
      "phone": {
        "type": "string",
        "title": "Telefon",
        "x-list": false,
        "x-mask": { "pattern": "last4", "exceptRoles": [ "manager", "idp-admin" ] }
      },
      "segment": { "type": "string", "title": "Segment" },
      "monthlyIncome": { "type": "number", "title": "Aylık Gelir / Ciro" },
      "kycScore": { "type": "integer", "title": "KYC Skoru" },
      "riskLevel": { "type": "string", "title": "Risk Seviyesi" },
      "internalRiskNote": {
        "type": "string",
        "title": "İç Denetim Notu (Sadece Yönetici)",
        "x-list": false,
        "x-roles": [ "manager" ]
      }
    }
  },
  "start": {
    "key": "start",
    "target": "kyc-scoring",
    "input": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "fullName", "identityNumber", "email", "segment", "monthlyIncome" ],
        "properties": {
          "fullName": { "type": "string", "minLength": 3, "maxLength": 120, "title": "Ad Soyad / Firma Ünvanı", "default": "Ahmet Yılmaz" },
          "identityNumber": { "type": "string", "minLength": 10, "maxLength": 11, "title": "T.C. Kimlik / Vergi No", "default": "12345678901" },
          "email": { "type": "string", "format": "email", "title": "E-posta", "default": "musteri@ornek.com" },
          "phone": { "type": "string", "minLength": 10, "maxLength": 15, "title": "Telefon", "default": "05321234567" },
          "segment": {
            "type": "string",
            "title": "Müşteri Segmenti",
            "enum": [ "Bireysel", "KOBİ", "Kurumsal" ],
            "default": "Bireysel"
          },
          "monthlyIncome": { "type": "number", "minimum": 0, "title": "Aylık Gelir / Ciro (₺)", "default": 45000 }
        }
      }
    },
    "onExecute": [
      {
        "task": "set",
        "config": {
          "values": {
            "requestedBy": "user.Name",
            "requestedAt": "now"
          }
        }
      }
    ]
  },
  "states": [
    {
      "key": "kyc-scoring",
      "title": "KYC & Risk Skorlama",
      "step": 1,
      "view": { "layout": "kyc-review" },
      "onEntry": [
        {
          "task": "setKey",
          "config": {
            "key": "CUST-{{ data.identityNumber }}",
            "ensureUnique": true
          }
        },
        {
          "task": "cache",
          "config": {
            "key": "kyc:CUST-{{ data.identityNumber }}",
            "ttl": "00:30:00",
            "into": "kycScore",
            "subTask": {
              "task": "set",
              "config": {
                "values": {
                  "kycScore": "data.monthlyIncome >= 50000 ? 850 : (data.monthlyIncome >= 20000 ? 740 : 610)"
                }
              }
            }
          }
        },
        {
          "task": "set",
          "config": {
            "values": {
              "riskLevel": "data.monthlyIncome >= 50000 ? \"Düşük\" : (data.monthlyIncome >= 20000 ? \"Orta\" : \"Yüksek\")",
              "internalRiskNote": "\"Otomatik MASAK/KYC taraması tamamlandı. Segment: \" + data.segment",
              "scoredAt": "now"
            }
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Müşteri KYC tamamlandı: {{ data.fullName }} (CUST-{{ data.identityNumber }}), Skor={{ data.kycScore }}"
          }
        }
      ],
      "transitions": [
        {
          "key": "auto-approve",
          "target": "active",
          "trigger": "Automatic",
          "rule": "data.segment == \"Bireysel\" && data.kycScore >= 700"
        },
        {
          "key": "require-review",
          "target": "kyc-review",
          "trigger": "Automatic",
          "default": true
        }
      ]
    },
    {
      "key": "kyc-review",
      "title": "Uyum & KYC İncelemesi",
      "step": 2,
      "subType": "Human",
      "view": { "layout": "kyc-review" },
      "transitions": [
        {
          "key": "approve-kyc",
          "title": "KYC Onayla",
          "target": "active",
          "roles": [ "manager" ],
          "view": { "inline": true },
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalNote": { "type": "string", "maxLength": 300, "title": "Uyum Onay Notu", "default": "MASAK ve KYC kontrolleri uygun bulundu." }
              }
            },
            "set": {
              "approvedBy": "user.Name",
              "approvedAt": "now"
            }
          }
        },
        {
          "key": "add-kyc-note",
          "title": "İnceleme Notu Ekle ($self)",
          "target": "$self",
          "reenter": false,
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "lastReviewNote" ],
              "properties": {
                "lastReviewNote": { "type": "string", "minLength": 3, "maxLength": 300, "title": "Ek İnceleme Notu", "default": "Müşteri faaliyet belgesi doğrulandı." }
              }
            },
            "set": {
              "noteUpdatedBy": "user.Name",
              "noteUpdatedAt": "now"
            }
          }
        },
        {
          "key": "reject-kyc",
          "title": "Reddet",
          "target": "rejected",
          "roles": [ "manager" ],
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "reason" ],
              "properties": {
                "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red Gerekçesi", "default": "KYC doğrulaması başarısız." }
              }
            },
            "set": {
              "rejectedBy": "user.Name",
              "rejectedAt": "now"
            }
          }
        }
      ]
    },
    {
      "key": "active",
      "title": "Aktif Müşteri",
      "step": 3,
      "subType": "Human",
      "view": { "layout": "kyc-review" },
      "transitions": [
        {
          "key": "update-income",
          "title": "Gelir / Segment Güncelle",
          "target": "kyc-scoring",
          "view": { "inline": true },
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "monthlyIncome", "segment" ],
              "properties": {
                "monthlyIncome": { "type": "number", "minimum": 0, "title": "Yeni Aylık Gelir / Ciro (₺)", "default": 75000 },
                "segment": {
                  "type": "string",
                  "title": "Müşteri Segmenti",
                  "enum": [ "Bireysel", "KOBİ", "Kurumsal" ],
                  "default": "Kurumsal"
                }
              }
            },
            "set": {
              "updatedBy": "user.Name"
            }
          }
        },
        {
          "key": "close-account",
          "title": "Müşteri Kaydını Kapat",
          "target": "closed",
          "roles": [ "manager" ],
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "closeReason" ],
              "properties": {
                "closeReason": { "type": "string", "minLength": 3, "maxLength": 300, "title": "Kapatma Nedeni", "default": "Müşteri talebi ile kapatıldı." }
              }
            },
            "set": {
              "closedBy": "user.Name",
              "closedAt": "now"
            }
          }
        }
      ]
    },
    {
      "key": "closed",
      "title": "Kapatıldı",
      "step": 4,
      "type": "Finish",
      "subType": "Cancelled",
      "view": { "layout": "kyc-review" }
    },
    {
      "key": "rejected",
      "title": "Reddedildi",
      "step": 4,
      "type": "Finish",
      "subType": "Error",
      "view": { "layout": "kyc-review" }
    }
  ]
}
