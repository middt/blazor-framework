{
  // v2: corporate customers score high for large amounts as well (v1 scored every amount > 20000 low).
  "key": "credit-check",
  "version": 2,
  "title": "Kredi kontrolü",
  "start": { "key": "start", "target": "scoring" },
  "states": [
    {
      "key": "scoring",
      "title": "Skorlama",
      "onEntry": [ { "task": "set", "config": { "values": {
        "score": "data.amount > 20000 && data.customerType != \"Kurumsal\" ? 40 : 85",
        "checkedAt": "now" } } } ],
      "transitions": [
        { "key": "pass", "target": "passed", "trigger": "Automatic", "rule": "data.score >= 50" },
        { "key": "fail", "target": "declined", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "passed", "title": "Uygun", "type": "Finish", "subType": "Success" },
    { "key": "declined", "title": "Uygun değil", "type": "Finish", "subType": "Error" }
  ]
}
