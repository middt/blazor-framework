{
  // 4/8: category, brand, name, model year, list price (+ optional initial stock) → price approval by a manager above
  // 5.000 TL (automatic below) → bike-create-product (products table) → starts stock-replenishment for the initial
  // stock when a store and a quantity > 0 were given.
  "key": "product-launch",
  "version": 1,
  "title": "Ürün lansmanı",
  "instanceAccess": { "mode": "owner", "supervisorRoles": [ "manager" ] },
  "start": {
    "key": "start",
    "target": "details",
    "onExecute": [ { "task": "set", "config": { "values": { "requestedBy": "user.Name", "requestedAt": "now" } } } ]
  },
  "states": [
    {
      "key": "details", "title": "Ürün bilgileri", "step": 1, "subType": "Human",
      "transitions": [
        {
          "key": "submit", "title": "Devam", "target": "price-routing", "view": { "inline": true },
          "input": { "into": "product", "schema": {
            "type": "object", "additionalProperties": false,
            "required": [ "categoryId", "brandId", "productName", "modelYear", "listPrice", "initialQuantity" ],
            "properties": {
              "categoryId": { "type": "integer", "minimum": 1, "title": "Kategori",
                              "x-lookup": { "entity": "Category", "valueField": "categoryId", "textField": "categoryName" } },
              "brandId": { "type": "integer", "minimum": 1, "title": "Marka",
                           "x-lookup": { "entity": "Brand", "valueField": "brandId", "textField": "brandName" } },
              "productName": { "type": "string", "minLength": 2, "maxLength": 255, "title": "Ürün adı" },
              "modelYear": { "type": "integer", "minimum": 2000, "maximum": 2100, "title": "Model yılı" },
              "listPrice": { "type": "number", "minimum": 1, "maximum": 99999999, "title": "Liste fiyatı (TL)" },
              "initialStoreId": { "type": "integer", "minimum": 1, "title": "İlk stok mağazası (isteğe bağlı)",
                                  "x-lookup": { "entity": "Store", "valueField": "storeId", "textField": "storeName" } },
              "initialQuantity": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0, "title": "İlk stok adedi (0 = yok)" }
            } } }
        }
      ]
    },
    {
      "key": "price-routing", "title": "Fiyat kontrolü",
      "transitions": [
        { "key": "needs-approval", "target": "price-approval", "trigger": "Automatic", "rule": "data.product.listPrice > 5000" },
        { "key": "auto-approve", "target": "creating", "trigger": "Automatic", "default": true,
          "onExecute": [ { "task": "set", "config": { "values": { "review.approvedBy": "\"Otomatik (5.000 TL altı)\"", "review.decidedAt": "now" } } } ] }
      ]
    },
    {
      "key": "price-approval", "title": "Fiyat onayı", "step": 2, "subType": "Human",
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "creating", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": { "into": "review",
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" } } },
        { "key": "back", "title": "Düzenle", "target": "details" }
      ]
    },
    {
      "key": "creating", "title": "Ürün oluşturuluyor",
      "onEntry": [ { "task": "bike-create-product", "config": {
        "productName": "{{ data.product.productName }}", "brandId": "{{ data.product.brandId }}", "categoryId": "{{ data.product.categoryId }}",
        "modelYear": "{{ data.product.modelYear }}", "listPrice": "{{ data.product.listPrice }}", "into": "productId" } } ],
      "transitions": [
        { "key": "failed", "target": "fix", "trigger": "Automatic", "rule": "data.error != null" },
        { "key": "created", "target": "launched", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "fix", "title": "Düzeltme gerekli", "step": 2, "subType": "Human", "view": { "layout": "bike-task-error" },
      "transitions": [ { "key": "edit", "title": "Bilgileri düzelt", "target": "details", "input": { "set": { "error": "null" } } } ]
    },
    {
      "key": "launched", "title": "Ürün yayında", "step": 3, "type": "Finish", "subType": "Success",
      "onEntry": [
        { "task": "set", "config": { "values": { "launchedAt": "now" } } },
        // Next link: the initial stock goes through stock-replenishment (manager approval / automatic after 1 minute).
        { "task": "startWorkflow", "key": "start-initial-stock",
          "when": "data.product.initialStoreId != null && data.product.initialQuantity > 0",
          "config": { "workflow": "stock-replenishment", "key": "product-{{ data.productId }}-initial",
                      "data": { "storeId": "{{ data.product.initialStoreId }}", "productId": "{{ data.productId }}",
                                "quantity": "{{ data.product.initialQuantity }}", "requestedBy": "product-launch" },
                      "into": "stockReplenishmentId" } }
      ]
    },
    { "key": "rejected", "title": "Reddedildi", "step": 3, "type": "Finish", "subType": "Error" },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "details", "price-approval", "fix" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
