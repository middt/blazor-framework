{
  // The built-in HTTP task adds Idempotency-Key automatically unless headers defines it explicitly.
  // This GET example uses failOnError=false to store a failed response instead of faulting the instance.
  "key": "test-http-tasks",
  "version": 1,
  "title": "Dış Servis ve HTTP Görevleri Test Akışı",
  "start": {
    "key": "start",
    "target": "send-request",
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "page": { "type": "integer" }
        }
      }
    }
  },
  "states": [
    {
      "key": "send-request",
      "title": "HTTP İsteği Gönderme (http-request)",
      "onEntry": [
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "HTTP dış servis isteği hazırlanıyor: {{ data.query }}"
          }
        },
        {
          "task": "http-request",
          "config": {
            "method": "GET",
            "url": "https://dummyjson.com/products/search",
            "queryParams": {
              "q": "{{ data.query }}",
              "limit": "5",
              "skip": "{{ data.page }}"
            },
            "headers": {
              "Accept": "application/json",
              "X-Trace-Id": "wf-trace-{{ data.query }}"
            },
            "failOnError": false,
            "timeoutSeconds": 15,
            "into": "httpResult"
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "HTTP yanıtı alındı. StatusCode: {{ data.httpResult.statusCode }}, Başarılı: {{ data.httpResult.isSuccess }}"
          }
        }
      ],
      "transitions": [
        { "key": "finish", "target": "completed", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "completed",
      "title": "Tamamlandı",
      "type": "Finish",
      "subType": "Success",
      "onEntry": [
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "HTTP test akışı tamamlandı."
          }
        }
      ]
    }
  ]
}
