{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WorkflowDb": ""
  },
  "Authentication": {
    "Authority": "http://localhost:8083/",
    "Audience": "middt-api"
  },
  "RebusSettings": {
    "InputQueueName": "middt-sample-api",
    "MaxDeliveryAttempts": 5,
    "ErrorQueueName": "error"
  },
  "CorsSettings": {
    "CorsModelList": [
      { "Name": "default", "Url": [ "https://localhost:7020", "http://localhost:5020" ] }
    ]
  },
  "DependencySettings": {
    "DependencyModelList": [
      {
        "ServiceType": "Middt.Sample.Common.IGreeting, Middt.Sample.Common",
        "ImplementationType": "Middt.Sample.Common.Greeting, Middt.Sample.Common",
        "Lifetime": "Transient"
      }
    ]
  }
}
