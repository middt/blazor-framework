{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-category-products",
  "title": "Kategori ürünleri",
  "kind": "page",
  "version": 1,
  "body": [
    { "widget": "link", "text": "← Kategoriler", "href": "/ui/bike-category" },
    {
      "widget": "record",
      "entity": "Category",
      "recordId": "{{ query.id }}",
      "notFound": "Kategori bulunamadı.",
      "children": [
        {
          "widget": "section",
          "children": [
            { "widget": "heading", "level": 3, "text": "{{ record.categoryName }}" },
            { "widget": "text", "style": "muted", "text": "Kategori #{{ record.categoryId }} ürünleri" }
          ]
        },
        {
          "widget": "grid",
          "id": "products",
          "entity": "Product",
          "filter": { "categoryId": "{{ record.categoryId }}" },
          "columns": [
            { "field": "productName", "title": "Ad" },
            { "field": "modelYear", "title": "Yıl", "width": "100px" },
            { "field": "listPrice", "title": "Fiyat", "format": "N2", "width": "140px" }
          ]
        }
      ]
    }
  ]
}
