{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "kyc-review",
  "title": "Müşteri KYC & Uyum Özeti",
  "kind": "view",
  "version": 3,
  "body": [
    {
      "widget": "alert",
      "severity": "success",
      "text": "Müşteri KYC doğrulaması tamamlandı ve hesap aktif durumda.",
      "visibleWhen": "instance.state == \"active\""
    },
    {
      "widget": "alert",
      "severity": "warning",
      "text": "Uyum ve MASAK incelemesi bekleniyor ({{ data.riskLevel }} Risk · Skor: {{ data.kycScore }}).",
      "visibleWhen": "instance.state == \"kyc-review\""
    },
    {
      "widget": "alert",
      "severity": "danger",
      "text": "Müşteri başvurusu reddedildi: {{ data.reason }}",
      "visibleWhen": "instance.state == \"rejected\""
    },
    {
      "widget": "alert",
      "severity": "info",
      "text": "Müşteri kaydı kapatıldı: {{ data.closeReason }}",
      "visibleWhen": "instance.state == \"closed\""
    },
    {
      "widget": "columns",
      "widths": [ "2", "1" ],
      "children": [
        {
          "widget": "layout",
          "key": "customer-summary-card"
        },
        {
          "widget": "section",
          "title": "Uyum & Denetim Notları",
          "children": [
            {
              "widget": "fields",
              "items": [
                { "label": "Müşteri Anahtarı", "value": "{{ instance.key }}", "visibleWhen": "instance.key != null" },
                { "label": "Skorlama Zamanı", "value": "{{ data.scoredAt }}", "format": "g", "visibleWhen": "data.scoredAt != null" },
                { "label": "Uyum Onay Notu", "value": "{{ data.approvalNote }}", "visibleWhen": "data.approvalNote != null" },
                { "label": "Son İnceleme Notu", "value": "{{ data.lastReviewNote }}", "visibleWhen": "data.lastReviewNote != null" },
                { "label": "İç Denetim Notu", "value": "{{ data.internalRiskNote }}", "visibleWhen": "user.IsInRole(\"manager\") && data.internalRiskNote != null" }
              ]
            }
          ]
        }
      ]
    },
    { "widget": "layout", "key": "workflow-footer" }
  ]
}
