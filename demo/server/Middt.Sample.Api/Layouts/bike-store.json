{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-store",
  "title": "Mağazalar",
  "kind": "page",
  "version": 2,
  "menu": { "title": "Mağazalar", "icon": "storefront", "order": 40 },
  "body": [
    { "widget": "heading", "text": "Mağazalar" },
    { "widget": "link", "text": "Yeni mağaza açılışı", "href": "/workflow/store-opening?start=1", "style": "button" },
    {
      "widget": "grid",
      "id": "stores",
      "entity": "Store",
      "columns": [
        { "field": "storeName", "title": "Ad" },
        { "field": "city", "title": "Şehir" },
        { "field": "phone", "title": "Telefon", "width": "160px" },
        { "field": "email", "title": "E-posta" },
        { "field": "active", "title": "Durum", "width": "100px", "template": "{{ row.active == true ? \"Aktif\" : \"Pasif\" }}" }
      ],
      "search": [
        { "field": "storeName", "label": "Ad" },
        { "field": "city", "label": "Şehir" },
        { "field": "status", "label": "Durum", "type": "select", "options": [ "Aktif", "Pasif" ] }
      ],
      "create": false,
      "edit": false,
      "delete": false,
      "rowActions": [
        { "text": "Değişiklik / kapatma", "icon": "edit_note", "navigate": "/workflow/store-opening?start=1&key=store-{{ row.storeId }}&storeId={{ row.storeId }}" }
      ]
    }
  ]
}
