{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-customer",
  "title": "Müşteriler",
  "kind": "page",
  "version": 2,
  "menu": { "title": "Müşteriler", "icon": "groups", "order": 60 },
  "body": [
    { "widget": "heading", "text": "Müşteriler" },
    { "widget": "link", "text": "Yeni müşteri kaydı", "href": "/workflow/customer-onboarding?start=1", "style": "button" },
    {
      "widget": "grid",
      "id": "customers",
      "entity": "Customer",
      "columns": [
        { "field": "firstName", "title": "Ad / unvan" },
        { "field": "lastName", "title": "Soyad / yetkili" },
        { "field": "email", "title": "E-posta" },
        { "field": "phone", "title": "Telefon", "width": "160px" },
        { "field": "city", "title": "Şehir" },
        { "field": "active", "title": "Durum", "width": "100px", "template": "{{ row.active == true ? \"Aktif\" : \"Pasif\" }}" }
      ],
      "search": [
        { "field": "firstName", "label": "Ad" },
        { "field": "lastName", "label": "Soyad" },
        { "field": "email", "label": "E-posta" },
        { "field": "city", "label": "Şehir" },
        { "field": "status", "label": "Durum", "type": "select", "options": [ "Aktif", "Pasif" ] }
      ],
      "create": false,
      "edit": false,
      "delete": false,
      "rowActions": [
        { "text": "Değişiklik / kapatma", "icon": "edit_note", "navigate": "/workflow/customer-onboarding?start=1&key=customer-{{ row.customerId }}&customerId={{ row.customerId }}" }
      ]
    }
  ]
}
