{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-task-error",
  "title": "Düzeltme gerekli",
  "kind": "view",
  "version": 1,
  "body": [
    { "widget": "alert", "severity": "danger", "text": "{{ data.error }}", "visibleWhen": "data.error != null" },
    { "widget": "text", "text": "Kayıt oluşturulamadı. Bilgileri düzeltip yeniden gönderin ya da süreci iptal edin." },
    { "widget": "text", "style": "small", "text": "Akış: {{ instance.workflow }} · Durum: {{ instance.stateTitle }}" }
  ]
}
