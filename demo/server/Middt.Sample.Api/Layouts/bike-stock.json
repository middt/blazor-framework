{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-stock",
  "title": "Stoklar",
  "kind": "page",
  "version": 1,
  "menu": { "title": "Stoklar", "icon": "inventory_2", "order": 70 },
  "body": [
    { "widget": "heading", "text": "Stoklar" },
    { "widget": "link", "text": "Stok ikmali talebi", "href": "/workflow/stock-replenishment?start=1", "style": "button" },
    { "widget": "text", "style": "muted", "text": "Stoklar ikmal ve sipariş karşılama akışlarıyla değişir." },
    {
      "widget": "grid",
      "id": "stocks",
      "entity": "Stock",
      "columns": [
        { "field": "storeName", "title": "Mağaza", "sortable": false },
        { "field": "productName", "title": "Ürün", "sortable": false },
        { "field": "quantity", "title": "Adet", "width": "110px" }
      ],
      "search": [
        { "field": "storeId", "label": "Mağaza", "type": "select", "lookup": { "entity": "Store", "valueField": "storeId", "textField": "storeName" } },
        { "field": "productId", "label": "Ürün", "type": "picker",
          "lookup": {
            "entity": "Product", "valueField": "productId", "textField": "productName", "title": "Ürün seç",
            "columns": [ { "field": "productName", "title": "Ad" }, { "field": "modelYear", "title": "Yıl" } ],
            "search": [ { "field": "productName", "label": "Ad" } ]
          } }
      ]
    }
  ]
}
