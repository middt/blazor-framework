{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-product",
  "title": "Ürünler",
  "kind": "page",
  "version": 3,
  "menu": { "title": "Product", "icon": "pedal_bike", "order": 20 },
  "body": [
    { "widget": "heading", "text": "Ürünler" },
    { "widget": "link", "text": "Yeni ürün lansmanı", "href": "/workflow/product-launch?start=1", "style": "button" },
    {
      "widget": "grid",
      "id": "products",
      "entity": "Product",
      "columns": [
        { "field": "productName", "title": "Ad" },
        { "field": "modelYear", "title": "Yıl", "width": "100px" },
        { "field": "listPrice", "title": "Fiyat", "format": "N2", "width": "140px" },
        { "field": "active", "title": "Durum", "width": "100px", "template": "{{ row.active == true ? \"Aktif\" : \"Pasif\" }}" }
      ],
      "search": [
        { "field": "productName", "label": "Ad" },
        { "field": "categoryId", "label": "Kategori", "type": "select", "lookup": { "entity": "Category", "valueField": "categoryId", "textField": "categoryName" } },
        { "field": "status", "label": "Durum", "type": "select", "options": [ "Aktif", "Pasif" ] }
      ],
      "create": false,
      "edit": false,
      "delete": false,
      "rowActions": [
        { "text": "Değişiklik / kapatma", "icon": "edit_note", "navigate": "/workflow/product-launch?start=1&key=product-{{ row.productId }}&productId={{ row.productId }}" }
      ]
    }
  ]
}
