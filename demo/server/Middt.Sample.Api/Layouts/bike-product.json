{
  "$schema": "../../../../spec/ui-layout.schema.json",
  "key": "bike-product",
  "title": "Ürünler",
  "kind": "page",
  "version": 1,
  "menu": { "title": "Product", "icon": "pedal_bike", "order": 20 },
  "body": [
    { "widget": "heading", "text": "Ürünler" },
    {
      "widget": "grid",
      "id": "products",
      "entity": "Product",
      "columns": [
        { "field": "productName", "title": "Ad" },
        { "field": "modelYear", "title": "Yıl", "width": "100px" },
        { "field": "listPrice", "title": "Fiyat", "format": "N2", "width": "140px" }
      ],
      "search": [
        { "field": "productName", "label": "Ad" },
        { "field": "categoryId", "label": "Kategori", "type": "select", "lookup": { "entity": "Category", "valueField": "categoryId", "textField": "categoryName" } }
      ],
      "create": true,
      "edit": true,
      "delete": true,
      "formTitle": "Ürün",
      "form": [
        { "field": "productName", "label": "Ad", "required": true, "maxLength": 255 },
        { "field": "categoryId", "label": "Kategori", "type": "select", "required": true, "lookup": { "entity": "Category", "valueField": "categoryId", "textField": "categoryName" } },
        { "field": "brandId", "label": "Marka no", "type": "integer", "required": true, "min": 1 },
        { "field": "modelYear", "label": "Model yılı", "type": "integer", "required": true, "min": 1900, "max": 2100 },
        { "field": "listPrice", "label": "Liste fiyatı", "type": "number", "required": true, "min": 0 }
      ]
    }
  ]
}
