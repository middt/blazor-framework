{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GeneralSettings": {
    "PathBase": "/",
    "SessionTimeoutInMinute": 20,
    "SessionAbsoluteTimeoutInMinute": 480
  },
  "ApiSettings": {
    "URL": "https://localhost:7010",
    "Version": "1.0"
  },
  "SecuritySettings": {
    "LoginPageURL": "/Account/Login",
    "LogoutPageURL": "/Account/Logout"
  },
  "Bff": {
    "Oidc": {
      "Authority": "http://localhost:8083/",
      "ClientId": "middt-angular"
    }
  },
  "DataProtection": {
    "ApplicationName": "middt-sample-angular"
  }
}
