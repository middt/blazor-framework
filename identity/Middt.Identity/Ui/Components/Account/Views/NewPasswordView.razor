@* View "new-password" (auth-reset-password). *@
@inherits JourneyViewBase

<h1 class="idp-title">Yeni şifre</h1>
<p class="idp-subtitle">Hesabınız için yeni bir şifre belirleyin.</p>

<ErrorSummary Errors="Errors" />

<JourneyForm Action="submit-password">
    @if (Data("userName") is { Length: > 0 } user)
    {
        @* Lets password managers attach the new password to the right account. *@
        <input type="text" name="username-hint" value="@user" autocomplete="username" hidden aria-hidden="true" readonly />
    }
    <InputField Id="Input_Password" Name="password" Label="Yeni şifre" Type="password" Autocomplete="new-password" Required="true" Autofocus="true" />
    <InputField Id="Input_ConfirmPassword" Name="@JourneyInputMapper.ConfirmPasswordField" Label="Yeni şifre (tekrar)" Type="password"
                Autocomplete="new-password" Required="true" />
    <button type="submit" class="idp-button idp-button-primary idp-button-block">@Title("submit-password", "Şifreyi kaydet")</button>
</JourneyForm>
