@* View "credentials" (auth-login): user name + password. The ids Input_Username / Input_Password and the single
   submit button are relied on by the E2E suites – keep them. *@
@inherits JourneyViewBase
@inject IOptions<MiddtIdentityOptions> IdentityOptions

<h1 class="idp-title">Oturum aç</h1>
@if (Data("clientName") is { Length: > 0 } client)
{
    <p class="idp-subtitle"><strong>@client</strong> uygulamasına devam etmek için oturum açın.</p>
}
else
{
    <p class="idp-subtitle">Devam etmek için hesabınızla oturum açın.</p>
}

<ErrorSummary Errors="Errors" />

<JourneyForm Action="submit-credentials">
    <InputField Id="Input_Username" Name="userName" Label="Kullanıcı adı veya e-posta" Autocomplete="username"
                Value="@Value("userName")" Required="true" Autofocus="true" MaxLength="256" />
    <InputField Id="Input_Password" Name="password" Label="Şifre" Type="password" Autocomplete="current-password" Required="true">
        <LabelAddon>
            <a class="idp-link-small" href="@ForgotPasswordUrl">Şifremi unuttum</a>
        </LabelAddon>
    </InputField>
    <button type="submit" class="idp-button idp-button-primary idp-button-block">@Title("submit-credentials", "Oturum aç")</button>
</JourneyForm>

@if (IdentityOptions.Value.AllowRegistration)
{
    <p class="idp-alt">Hesabınız yok mu? <a href="@RegisterUrl">Hesap oluşturun</a></p>
}
