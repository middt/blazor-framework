@* Sets a user's password (validated by the configured password validators before the old one is removed). *@

<form class="idp-dialog-form" @onsubmit="SaveAsync">
    <RadzenStack Gap="0.75rem">
        <RadzenFormField Text="Yeni şifre" Variant="Variant.Outlined">
            <RadzenPassword @bind-Value="password" Name="NewPassword" autocomplete="new-password" aria-required="true" />
        </RadzenFormField>
        <RadzenFormField Text="Yeni şifre (tekrar)" Variant="Variant.Outlined">
            <RadzenPassword @bind-Value="confirm" Name="ConfirmPassword" autocomplete="new-password" aria-required="true" />
        </RadzenFormField>
        <ErrorSummary Errors="errors" Id="idp-password-errors" />
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Vazgeç" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Kaydet" ButtonStyle="ButtonStyle.Primary" IsBusy="saving" />
        </RadzenStack>
    </RadzenStack>
</form>

@code {
    [Parameter, EditorRequired]
    public string UserId { get; set; } = string.Empty;

    private string? password;
    private string? confirm;
    private bool saving;
    private IReadOnlyList<string> errors = [];

    private async Task SaveAsync()
    {
        errors = [];
        if (string.IsNullOrEmpty(password) || !string.Equals(password, confirm, StringComparison.Ordinal))
        {
            errors = [string.IsNullOrEmpty(password) ? "Şifre zorunludur." : "Şifreler eşleşmiyor."];
            return;
        }

        saving = true;
        var ok = await RunAsync(async sp =>
        {
            var users = sp.GetRequiredService<UserManager<MiddtIdentityUser>>();
            if (await users.FindByIdAsync(UserId) is not { } user)
            {
                return ["Kullanıcı bulunamadı."];
            }

            foreach (var validator in users.PasswordValidators)
            {
                if (Errors(await validator.ValidateAsync(users, user, password)) is { Count: > 0 } invalid)
                {
                    return invalid;
                }
            }

            if (await users.HasPasswordAsync(user) && Errors(await users.RemovePasswordAsync(user)) is { Count: > 0 } removeErrors)
            {
                return removeErrors;
            }

            return Errors(await users.AddPasswordAsync(user, password));
        }, "Şifre değiştirildi.");
        saving = false;

        if (ok)
        {
            Dialogs.Close(true);
        }
    }
}
