@page "/admin/roles"
@inject IOptions<MiddtIdentityOptions> IdentityOptions

<PageTitle>Roller</PageTitle>

<div class="idp-admin-toolbar">
    <h1 class="idp-admin-title">Roller</h1>
    <RadzenButton Icon="add" Text="Yeni rol" ButtonStyle="ButtonStyle.Primary" Click="@(() => EditAsync(null))" />
</div>

<RadzenDataGrid @ref="grid" TItem="RoleRow" Data="rows" Count="count" LoadData="LoadAsync" IsLoading="loading"
                AllowPaging="true" PageSize="20" PagerHorizontalAlign="HorizontalAlign.Left" EmptyText="Kayıt bulunamadı." Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn TItem="RoleRow" Property="Name" Title="Ad" Sortable="false" />
        <RadzenDataGridColumn TItem="RoleRow" Property="Claims" Title="Talepler (claims)" Sortable="false" />
        <RadzenDataGridColumn TItem="RoleRow" Property="UserCount" Title="Kullanıcı sayısı" Sortable="false" Width="10rem" />
        <RadzenDataGridColumn TItem="RoleRow" Title="İşlemler" Sortable="false" Width="8rem" TextAlign="TextAlign.Right">
            <Template Context="role">
                <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small" title="Düzenle" aria-label="@($"{role.Name} düzenle")" Click="@(() => EditAsync(role.Id))" />
                @if (!string.Equals(role.Name, IdentityOptions.Value.AdminRole, StringComparison.OrdinalIgnoreCase))
                {
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" title="Sil" aria-label="@($"{role.Name} sil")" Click="@(() => DeleteAsync(role))" />
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private sealed record RoleRow(string Id, string? Name, string Claims, int UserCount);

    private RadzenDataGrid<RoleRow>? grid;
    private List<RoleRow> rows = [];
    private int count;
    private bool loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && grid is not null)
        {
            await grid.Reload();
        }
    }

    private async Task LoadAsync(LoadDataArgs args)
    {
        loading = true;
        try
        {
            (rows, count) = await WithScopeAsync(async sp =>
            {
                var roleManager = sp.GetRequiredService<RoleManager<IdentityRole>>();
                var userManager = sp.GetRequiredService<UserManager<MiddtIdentityUser>>();
                var allRoles = await roleManager.Roles.OrderBy(r => r.Name).ToListAsync();
                var total = allRoles.Count;
                var page = new List<RoleRow>();
                foreach (var role in allRoles.Skip(args.Skip ?? 0).Take(args.Top ?? 20))
                {
                    var claims = await roleManager.GetClaimsAsync(role);
                    var users = role.Name is not null ? await userManager.GetUsersInRoleAsync(role.Name) : [];
                    page.Add(new RoleRow(
                        role.Id,
                        role.Name,
                        string.Join(", ", claims.Select(c => $"{c.Type}={c.Value}")),
                        users.Count));
                }

                return (page, total);
            });
        }
        finally
        {
            loading = false;
        }
    }

    private async Task EditAsync(string? id)
    {
        if (await Dialogs.OpenAsync<RoleEditDialog>(id is null ? "Yeni rol" : "Rolü düzenle",
                new Dictionary<string, object?> { [nameof(RoleEditDialog.Id)] = id }, new DialogOptions { Width = "560px" }) is true && grid is not null)
        {
            await grid.Reload();
        }
    }

    private async Task DeleteAsync(RoleRow role)
    {
        if (await Dialogs.Confirm($"{role.Name} rolü silinecek.", "Rolü sil",
                new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç" }) != true)
        {
            return;
        }

        var ok = await RunAsync(async sp =>
        {
            var manager = sp.GetRequiredService<RoleManager<IdentityRole>>();
            if (await manager.FindByIdAsync(role.Id) is { } entity)
            {
                var result = await manager.DeleteAsync(entity);
                if (!result.Succeeded)
                {
                    return [.. result.Errors.Select(e => e.Description)];
                }
            }

            return Ok;
        }, "Rol silindi.");

        if (ok && grid is not null)
        {
            await grid.Reload();
        }
    }
}
