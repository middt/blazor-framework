@* Shows a newly generated client secret once (OpenIddict stores only its hash). *@

<RadzenStack Gap="0.75rem">
    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
        Bu secret yalnızca şimdi gösterilir; saklanmaz. Kopyalayıp güvenli bir yerde (ör. gizli yapılandırma) saklayın.
    </RadzenAlert>
    <label for="idp-client-secret" class="idp-label">Secret</label>
    <input id="idp-client-secret" class="idp-input idp-key" value="@Secret" readonly autocomplete="off" spellcheck="false" />
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Text="Kapat" ButtonStyle="ButtonStyle.Primary" Click="@(() => Dialogs.Close(true))" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter, EditorRequired]
    public string Secret { get; set; } = string.Empty;
}
