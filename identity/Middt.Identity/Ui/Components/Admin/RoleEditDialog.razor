@* Create (Id = null) or edit an IdentityRole and its role claims. *@
@using System.Security.Claims

@if (!loaded)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" aria-label="Yükleniyor" />
}
else
{
    <form class="idp-dialog-form" @onsubmit="SaveAsync">
        <RadzenStack Gap="0.75rem">
            <RadzenFormField Text="Rol adı (ör. manager)" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="name" Name="Name" autocomplete="off" aria-required="true" />
            </RadzenFormField>
            <RadzenFormField Text="Rol talepleri / claims (her satıra bir tip=değer)" Variant="Variant.Outlined">
                <RadzenTextArea @bind-Value="claimsText" Name="Claims" Rows="4" placeholder="permission=users.read" />
            </RadzenFormField>
            <ErrorSummary Errors="errors" Id="idp-role-errors" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="Vazgeç" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
                <RadzenButton ButtonType="ButtonType.Submit" Text="Kaydet" ButtonStyle="ButtonStyle.Primary" IsBusy="saving" />
            </RadzenStack>
        </RadzenStack>
    </form>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private string? name;
    private string? claimsText;
    private bool loaded;
    private bool saving;
    private IReadOnlyList<string> errors = [];

    protected override async Task OnInitializedAsync()
    {
        if (Id is not null)
        {
            await WithScopeAsync(async sp =>
            {
                var manager = sp.GetRequiredService<RoleManager<IdentityRole>>();
                if (await manager.FindByIdAsync(Id) is { } role)
                {
                    name = role.Name;
                    var claims = await manager.GetClaimsAsync(role);
                    claimsText = string.Join('\n', claims.Select(c => $"{c.Type}={c.Value}"));
                }

                return true;
            });
        }

        loaded = true;
    }

    private async Task SaveAsync()
    {
        errors = [];
        if (string.IsNullOrWhiteSpace(name) || name.Trim().Contains(' ', StringComparison.Ordinal))
        {
            errors = ["Rol adı zorunludur ve boşluk içeremez."];
            return;
        }

        var parsedClaims = new List<Claim>();
        foreach (var line in (claimsText ?? string.Empty).Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eq = line.IndexOf('=', StringComparison.Ordinal);
            if (eq <= 0 || eq == line.Length - 1)
            {
                errors = [$"Geçersiz talep biçimi: '{line}'. 'tip=değer' biçiminde olmalıdır."];
                return;
            }

            parsedClaims.Add(new Claim(line[..eq].Trim(), line[(eq + 1)..].Trim()));
        }

        saving = true;
        var ok = await RunAsync(async sp =>
        {
            var manager = sp.GetRequiredService<RoleManager<IdentityRole>>();
            IdentityRole? role = null;
            if (Id is not null)
            {
                role = await manager.FindByIdAsync(Id);
                if (role is null)
                {
                    return ["Rol bulunamadı."];
                }

                role.Name = name.Trim();
                var updateResult = await manager.UpdateAsync(role);
                if (!updateResult.Succeeded)
                {
                    return [.. updateResult.Errors.Select(e => e.Description)];
                }
            }
            else
            {
                if (await manager.FindByNameAsync(name.Trim()) is not null)
                {
                    return ["Bu adda bir rol zaten var."];
                }

                role = new IdentityRole(name.Trim());
                var createResult = await manager.CreateAsync(role);
                if (!createResult.Succeeded)
                {
                    return [.. createResult.Errors.Select(e => e.Description)];
                }
            }

            var existingClaims = await manager.GetClaimsAsync(role);
            foreach (var existing in existingClaims)
            {
                if (!parsedClaims.Any(c => c.Type == existing.Type && c.Value == existing.Value))
                {
                    await manager.RemoveClaimAsync(role, existing);
                }
            }

            foreach (var claim in parsedClaims)
            {
                if (!existingClaims.Any(c => c.Type == claim.Type && c.Value == claim.Value))
                {
                    await manager.AddClaimAsync(role, claim);
                }
            }

            return Ok;
        }, "Rol kaydedildi.");
        saving = false;

        if (ok)
        {
            Dialogs.Close(true);
        }
    }
}
