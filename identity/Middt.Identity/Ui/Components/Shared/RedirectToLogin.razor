@* Interactive navigation to a protected page without a session: full page load of the sign-in page. *@
@inject NavigationManager Navigation

<p class="idp-muted" role="status">Oturum açma sayfasına yönlendiriliyorsunuz…</p>

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(JourneyLinks.WithReturnUrl(MiddtIdentityDefaults.LoginPath, returnUrl), forceLoad: true);
    }
}
