{
  // Forgotten password: e-mail → code → new password → done. Never reveals whether an address exists: the code step
  // follows for every address (a code is only sent to existing ones; any code fails for unknown ones).
  "key": "auth-reset-password",
  "version": 1,
  "title": "Şifre sıfırlama",
  "roles": [ "idp-journey" ],
  "timeout": { "after": "PT15M", "target": "expired" },
  "start": {
    "key": "start",
    "target": "request",
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "returnUrl": { "type": "string", "maxLength": 4000 },
          "_bindingHash": { "type": "string" }
        }
      }
    }
  },
  "states": [
    {
      "key": "request",
      "title": "Şifremi unuttum",
      "step": 1,
      "view": { "component": "reset-request" },
      "transitions": [
        {
          "key": "submit-email",
          "title": "Kod gönder",
          "target": "verify",
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "email" ],
              "properties": { "email": { "type": "string", "title": "E-posta", "format": "email", "maxLength": 256 } }
            },
            "into": "form"
          },
          "onExecute": [ { "task": "idp-send-email-code", "config": { "purpose": "reset-password" } } ]
        }
      ]
    },
    {
      "key": "verify",
      "title": "Doğrulama kodu",
      "step": 2,
      "view": { "component": "email-code" },
      "transitions": [
        {
          "key": "submit-code",
          "title": "Doğrula",
          "target": "check-code",
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "code" ],
              "properties": { "code": { "type": "string", "title": "Doğrulama kodu", "minLength": 6, "maxLength": 6 } }
            },
            "into": "form",
            "sensitive": [ "code" ]
          },
          "onExecute": [ { "task": "idp-verify-email-code" } ]
        },
        {
          "key": "resend-code",
          "title": "Kodu tekrar gönder",
          "target": "$self",
          "onExecute": [ { "task": "idp-send-email-code", "config": { "purpose": "reset-password", "resend": true } } ]
        }
      ]
    },
    {
      "key": "check-code",
      "title": "Kontrol",
      "transitions": [
        { "key": "code-too-many-attempts", "target": "failed", "trigger": "Automatic", "rule": "data.attemptsExceeded == true" },
        { "key": "code-ok", "target": "new-password", "trigger": "Automatic", "rule": "data.codeValid == true" },
        { "key": "code-retry", "target": "verify", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "new-password",
      "title": "Yeni şifre",
      "step": 3,
      "view": { "component": "new-password" },
      "transitions": [
        {
          "key": "submit-password",
          "title": "Şifreyi değiştir",
          "target": "check-password",
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "password" ],
              "properties": { "password": { "type": "string", "title": "Yeni şifre", "minLength": 1, "maxLength": 512 } }
            },
            "into": "form",
            "sensitive": [ "password" ]
          },
          "onExecute": [ { "task": "idp-reset-password" } ]
        }
      ]
    },
    {
      "key": "check-password",
      "title": "Kontrol",
      "transitions": [
        { "key": "password-changed", "target": "done", "trigger": "Automatic", "rule": "data.passwordReset == true" },
        { "key": "password-retry", "target": "new-password", "trigger": "Automatic", "default": true }
      ]
    },
    { "key": "done", "title": "Şifre değiştirildi", "type": "Finish", "subType": "Success" },
    { "key": "failed", "title": "Doğrulama başarısız", "type": "Finish", "subType": "Error" },
    { "key": "expired", "title": "Süre doldu", "type": "Finish", "subType": "Timeout" }
  ]
}
