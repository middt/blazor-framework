<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Middt Identity: the OAuth 2.0 / OpenID Connect server of Middt applications, a ready to run service configured
    through appsettings / environment (database, issuer, certificate, clients, users). Sign-in, registration, password
    reset and MFA run as workflow journeys (Journeys/*.json); account pages and the /admin console are Blazor (Ui/).
  -->
  <PropertyGroup>
    <ContainerRepository>middt-identity</ContainerRepository>
    <!-- .NET 10: _framework/blazor.web.js ships in Microsoft.AspNetCore.App.Internal.Assets; make sure it is restored and published. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.Core" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\server\Middt.Framework.Common\Middt.Framework.Common.csproj" />
    <ProjectReference Include="..\..\sdk\server\Middt.Framework.Workflow\Middt.Framework.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Middt.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default journeys (workflow definitions), embedded; Identity:JourneyDirectory can override them by key. -->
    <Content Remove="Journeys\*.json" />
    <EmbeddedResource Include="Journeys\*.json" />
  </ItemGroup>

</Project>
