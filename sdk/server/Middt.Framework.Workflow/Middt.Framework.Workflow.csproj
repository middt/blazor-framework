<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Middt Framework Workflow</Product>
    <Description>Embedded, JSON defined workflow (state machine) engine for Middt applications: states, manual/automatic/scheduled transitions, tasks, timers, subflows and history on EF Core – no Dapr required.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Middt.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Middt.Framework.Expressions\Middt.Framework.Expressions.csproj" />
    <ProjectReference Include="..\..\shared\Middt.Framework.Model\Middt.Framework.Model.csproj" />
  </ItemGroup>

</Project>
