@inherits UiWidgetBase

@if (Items() is { } items)
{
    if (items.Count == 0)
    {
        <p class="middt-ui-text middt-ui-text-muted">@(Node.StringProp("empty") ?? "Kayıt yok.")</p>
    }
    else
    {
        var rowTransition = RowTransition();
        <ul class="middt-ui-list">
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                if (item is JsonObject itemObj && itemObj["rowNumber"] is null)
                {
                    itemObj["rowNumber"] = i + 1;
                }

                var rowContext = Context.With(UiExpressions.Row, item);
                <li>
                    <UiNodeList Nodes="Node.Children" Context="@rowContext" />
                    @if (rowTransition is { } tr)
                    {
                        <div class="middt-ui-toolbar rz-mt-1">
                            <RadzenButton Text="@tr.Text" Icon="@tr.Icon" ButtonStyle="@tr.Style" Size="ButtonSize.Small"
                                          Click="@(() => ExecuteRowTransitionAsync(tr, rowContext))" data-transition="@tr.Key" />
                        </div>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private const int MaxItems = 1000;

    private List<JsonNode?>? Items()
    {
        try
        {
            return Node.StringProp("source") is { } source && Context.Render(JsonValue.Create($"{{{{ {source} }}}}")) is JsonArray array
                ? [.. array.Take(MaxItems).Select(i => i?.DeepClone())]
                : [];
        }
        catch (Middt.Framework.Expressions.Portable.PortableExpressionException)
        {
            return [];
        }
    }

    private RowTransitionSpec? RowTransition()
    {
        if (Node.ObjectProp("rowTransition") is not { } obj
            || UiFieldJson.GetString(obj, "key") is not { Length: > 0 } key
            || !Context.CanExecuteTransition(key))
        {
            return null;
        }

        var text = UiFieldJson.GetString(obj, "text") ?? key;
        var icon = UiFieldJson.GetString(obj, "icon");
        var style = UiFieldJson.GetString(obj, "style") switch
        {
            "danger" => ButtonStyle.Danger,
            "secondary" => ButtonStyle.Secondary,
            "light" => ButtonStyle.Light,
            _ => ButtonStyle.Primary,
        };
        return new RowTransitionSpec(key, text, icon, style, obj["input"] as JsonObject);
    }

    private Task ExecuteRowTransitionAsync(RowTransitionSpec tr, UiRenderContext rowContext)
    {
        if (Context.ExecuteTransition is not { } execute)
        {
            return Task.CompletedTask;
        }

        var renderedInput = tr.InputTemplate is null ? null : rowContext.Render(tr.InputTemplate) as JsonObject;
        return execute(tr.Key, renderedInput);
    }

    private sealed record RowTransitionSpec(string Key, string Text, string? Icon, ButtonStyle Style, JsonObject? InputTemplate);
}
