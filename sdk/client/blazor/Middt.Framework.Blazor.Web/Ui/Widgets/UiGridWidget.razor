@namespace Middt.Framework.Blazor.Web.Ui.Widgets
@using System.Text.Json.Nodes
@using Middt.Framework.Ui.Rendering
@inherits UiWidgetBase

<UiDataGrid @ref="dataGrid" Entity="@entity" Columns="@columns" SearchFields="@search" FixedFilter="FixedFilter" Context="Context"
            Title="@(Node.StringProp("title") is null ? null : Text("title"))" PageSize="@Node.IntProp("pageSize", 10)"
            AutoLoad="@Node.BoolProp("autoLoad", true)" IdPrefix="@ElementId()"
            Toolbar="@(canCreate ? CreateButton : null)" RowActions="@(HasRowActions ? RowButtons : null)" ActionsWidth="@ActionsWidth" />

@code {
    private UiDataGrid dataGrid = default!;
    private string entity = string.Empty;
    private List<UiColumn> columns = [];
    private List<UiField> search = [];
    private List<UiField> form = [];
    private List<JsonObject> actions = [];
    private bool canCreate;
    private bool canEdit;
    private bool canDelete;

    [Inject]
    private UiDataClient DataClient { get; set; } = default!;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    private bool HasRowActions => canEdit || canDelete || actions.Count > 0;

    private string ActionsWidth => $"{Math.Max(70, ((canEdit ? 1 : 0) + (canDelete ? 1 : 0) + actions.Count) * 48 + 24)}px";

    protected override void OnParametersSet()
    {
        entity = Node.StringProp("entity") ?? string.Empty;
        columns = UiColumn.ParseAll(Node.ArrayProp("columns"));
        search = UiField.ParseAll(Node.ArrayProp("search"));
        form = UiField.ParseAll(Node.ArrayProp("form"));
        actions = [.. (Node.ArrayProp("rowActions") ?? []).OfType<JsonObject>()];
        canCreate = Node.BoolProp("create") && form.Count > 0;
        canEdit = Node.BoolProp("edit") && form.Count > 0;
        canDelete = Node.BoolProp("delete");
    }

    private JsonObject? FixedFilter()
    {
        if (Node.ObjectProp("filter") is not { } filter)
        {
            return null;
        }

        try
        {
            return Context.Render(filter) as JsonObject;
        }
        catch (Middt.Framework.Expressions.Portable.PortableExpressionException ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Filtre hatası", ex.Message);
            return null;
        }
    }

    private RenderFragment CreateButton => __builder =>
    {
        <RadzenButton Icon="add" Text="Yeni" ButtonStyle="ButtonStyle.Primary" Click="CreateAsync" />
    };

    private RenderFragment<JsonObject> RowButtons => row => __builder =>
    {
        @foreach (var action in actions)
        {
            var text = UiFieldJson.GetString(action, "text");
            <RadzenButton Icon="@(UiFieldJson.GetString(action, "icon") ?? "open_in_new")" Text="@(UiFieldJson.GetString(action, "icon") is null ? text : null)"
                          Size="ButtonSize.Small" ButtonStyle="@Style(UiFieldJson.GetString(action, "style"))"
                          title="@text" aria-label="@(text ?? "Aç")" Click="@(() => Navigate(action, row))" />
        }
        @if (canEdit)
        {
            <RadzenButton Icon="edit" Size="ButtonSize.Small" title="Düzenle" aria-label="Düzenle" Click="@(() => EditAsync(row))" />
        }
        @if (canDelete)
        {
            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" title="Sil" aria-label="Sil" Click="@(() => DeleteAsync(row))" />
        }
    };

    private static ButtonStyle Style(string? style) => style switch
    {
        "secondary" => ButtonStyle.Secondary,
        "light" => ButtonStyle.Light,
        "danger" => ButtonStyle.Danger,
        _ => ButtonStyle.Primary,
    };

    private void Navigate(JsonObject action, JsonObject row)
    {
        var url = Context.With(UiExpressions.Row, row).Text(UiFieldJson.GetString(action, "navigate"));
        if (UiUrl.IsLocal(url))
        {
            NavigationManager.NavigateTo(url);
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Hata", "Geçersiz bağlantı.");
        }
    }

    private Task CreateAsync() => OpenFormAsync(new JsonObject(), insert: true);

    private Task EditAsync(JsonObject row) => OpenFormAsync((JsonObject)row.DeepClone(), insert: false);

    private async Task OpenFormAsync(JsonObject model, bool insert)
    {
        var title = Node.StringProp("formTitle") ?? Node.StringProp("title") ?? entity;
        var saved = await DialogService.OpenAsync<UiFormDialog>(
            insert ? $"{title} - Yeni" : $"{title} - Düzenle",
            new Dictionary<string, object?>
            {
                [nameof(UiFormDialog.Fields)] = form,
                [nameof(UiFormDialog.Model)] = model,
                [nameof(UiFormDialog.Context)] = Context,
                [nameof(UiFormDialog.Save)] = (Func<JsonObject, Task<string?>>)(async m =>
                {
                    var response = insert ? await DataClient.InsertAsync(entity, m) : await DataClient.UpdateAsync(entity, m);
                    return response.IsSuccess ? null : response.ErrorText;
                }),
            },
            new DialogOptions { Width = "min(640px, 95vw)", CloseDialogOnEsc = true });

        if (saved is not null)
        {
            Notification.Notify(NotificationSeverity.Success, "Kaydedildi", string.Empty);
            await dataGrid.ReloadAsync();
        }
    }

    private async Task DeleteAsync(JsonObject row)
    {
        if (await DialogService.Confirm("Kayıt silinsin mi?", "Sil", new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç" }) != true)
        {
            return;
        }

        var response = await DataClient.DeleteAsync(entity, row);
        if (response.IsSuccess)
        {
            Notification.Notify(NotificationSeverity.Success, "Silindi", string.Empty);
            await dataGrid.ReloadAsync();
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Silinemedi", response.ErrorText);
        }
    }
}
