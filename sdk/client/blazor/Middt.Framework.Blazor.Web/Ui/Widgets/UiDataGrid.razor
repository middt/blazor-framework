@namespace Middt.Framework.Blazor.Web.Ui.Widgets
@using System.Text.Json.Nodes
@using Middt.Framework.Ui.Rendering
@implements IDisposable

<div class="middt-ui-grid" data-entity="@Entity">
    @if (SearchFields.Count > 0)
    {
        <RadzenCard class="rz-mb-2">
            <form class="middt-ui-form" role="search" aria-label="@($"{Title ?? Entity} arama")" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <div class="middt-ui-search">
                    @foreach (var field in SearchFields)
                    {
                        <UiFieldEditor @key="field.Field" Field="field" Target="filter" Context="Context" IdPrefix="@($"{IdPrefix}-search")" />
                    }
                </div>
                <div class="middt-ui-toolbar">
                    <RadzenButton ButtonType="ButtonType.Submit" Icon="search" Text="Ara" />
                    <RadzenButton Icon="search_off" Text="Temizle" ButtonStyle="ButtonStyle.Light" Click="ClearAsync" />
                </div>
            </form>
        </RadzenCard>
    }

    @if (Title is not null || Toolbar is not null)
    {
        <div class="middt-ui-toolbar rz-mb-2" style="justify-content: space-between">
            @if (Title is not null)
            {
                <h3 class="middt-ui-section-title">@Title</h3>
            }
            <div class="middt-ui-toolbar">@Toolbar</div>
        </div>
    }

    <RadzenDataGrid @ref="grid" TItem="JsonObject" Data="@rows" Count="@count" LoadData="OnLoadData" IsLoading="@loading"
                    AllowPaging="true" AllowSorting="true" AllowColumnResize="true" PageSize="@pageSize"
                    PageSizeOptions="@PageSizeOptions" ShowPagingSummary="true"
                    EmptyText="@(searched ? "Kayıt bulunamadı." : "Aramak için Ara düğmesini kullanın.")" Style="min-height: 240px">
        <Columns>
            @foreach (var column in Columns)
            {
                <RadzenDataGridColumn @key="column.Field" TItem="JsonObject" Title="@column.Title" Width="@column.Width"
                                      Sortable="@column.Sortable" SortProperty="@column.SortProperty">
                    <Template Context="row">@CellText(column, row)</Template>
                </RadzenDataGridColumn>
            }
            @if (RowActions is not null)
            {
                <RadzenDataGridColumn TItem="JsonObject" Sortable="false" Width="@ActionsWidth" Title="İşlemler">
                    <Template Context="row">
                        <div class="middt-ui-toolbar">@RowActions(row)</div>
                    </Template>
                </RadzenDataGridColumn>
            }
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private static readonly int[] PageSizeOptions = [10, 20, 50, 100];
    private readonly CancellationTokenSource cancellation = new();
    private RadzenDataGrid<JsonObject> grid = default!;
    private JsonObject filter = [];
    private List<JsonObject> rows = [];
    private int count;
    private bool loading;
    private bool rendered;
    private bool searched;
    private int page = 1;
    private string? sortProperty;
    private bool ascending;
    private int pageSize = 10;
    private int? pageSizeParameter;

    [Inject]
    private UiDataClient DataClient { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Entity { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public List<UiColumn> Columns { get; set; } = [];

    [Parameter]
    public List<UiField> SearchFields { get; set; } = [];

    /// <summary>Fixed filter values merged into every request (e.g. the parent id).</summary>
    [Parameter]
    public Func<JsonObject?>? FixedFilter { get; set; }

    [Parameter, EditorRequired]
    public UiRenderContext Context { get; set; } = default!;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? Toolbar { get; set; }

    [Parameter]
    public RenderFragment<JsonObject>? RowActions { get; set; }

    [Parameter]
    public string ActionsWidth { get; set; } = "140px";

    /// <summary>Initial page size (the user can change it with the pager).</summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>Loads the first page when shown (otherwise on the first search).</summary>
    [Parameter]
    public bool AutoLoad { get; set; } = true;

    [Parameter]
    public string IdPrefix { get; set; } = "ui-grid";

    protected override void OnParametersSet()
    {
        // The pager changes the page size; it is kept here instead of writing to the parameter (BL0005).
        if (pageSizeParameter != PageSize)
        {
            pageSizeParameter = PageSize;
            pageSize = PageSize;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The grid asks for data while initialising (also during prerendering); the first load runs here instead.
            rendered = true;
            if (AutoLoad)
            {
                searched = true;
                await LoadAsync();
                StateHasChanged();
            }
        }
    }

    /// <summary>Reloads the current page (e.g. after a change).</summary>
    public async Task ReloadAsync()
    {
        searched = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        searched = true;
        page = 1;
        if (grid is not null)
        {
            await grid.FirstPage(true); // resets the pager and calls LoadData
        }
        else
        {
            await LoadAsync();
        }
    }

    private async Task ClearAsync()
    {
        filter = [];
        await SearchAsync();
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        if (!rendered || !searched)
        {
            return;
        }

        if (args.Top is > 0)
        {
            pageSize = args.Top.Value;
            page = ((args.Skip ?? 0) / args.Top.Value) + 1;
        }

        var sort = args.Sorts?.FirstOrDefault(s => s.SortOrder is not null);
        sortProperty = sort?.Property;
        ascending = sort?.SortOrder == SortOrder.Ascending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var requestFilter = (JsonObject)filter.DeepClone();
            if (FixedFilter?.Invoke() is { } fixedFilter)
            {
                foreach (var (name, value) in fixedFilter)
                {
                    requestFilter[name] = value?.DeepClone();
                }
            }

            var response = await DataClient.GetItemsAsync(Entity, UiDataClient.SearchRequest(requestFilter, page, pageSize, sortProperty, ascending), cancellation.Token);
            if (response.IsSuccess)
            {
                rows = response.Data ?? [];
                count = response.Count;
            }
            else
            {
                rows = [];
                count = 0;
                Notification.Notify(NotificationSeverity.Error, "Hata", response.ErrorText);
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            loading = false;
        }
    }

    private string CellText(UiColumn column, JsonObject row) =>
        column.Template is { } template
            ? Context.With(UiExpressions.Row, row).Text(template, column.Format)
            : Context.Format(row[column.Field], column.Format);

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
