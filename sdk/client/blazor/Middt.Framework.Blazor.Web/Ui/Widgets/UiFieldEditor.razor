@namespace Middt.Framework.Blazor.Web.Ui.Widgets
@using System.Globalization
@using System.Text.Json.Nodes
@using Middt.Framework.Ui.Rendering
@implements IDisposable

@{ var id = $"{IdPrefix}-{Field.Field}"; var errorId = $"{id}-error"; }
<div class="middt-ui-input @(Error is null ? null : "middt-ui-invalid")" data-field="@Field.Field">
    @if (Field.Type == "checkbox")
    {
        <div class="middt-ui-check">
            <RadzenCheckBox TValue="bool" Name="@id" Value="@BoolValue" ValueChanged="@(v => SetAsync(JsonValue.Create(v)))" Disabled="@Disabled"
                            InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Field.Label })" />
            <label for="@id">@Field.Label</label>
        </div>
    }
    else
    {
        <label for="@id">
            @Field.Label
            @if (Field.Required)
            {
                <span class="middt-jsf-required" title="Zorunlu alan">*</span>
            }
        </label>
        @switch (Field.Type)
        {
            case "textarea":
                <RadzenTextArea Name="@id" id="@id" Value="@TextValue" ValueChanged="@(v => SetTextAsync(v))" Disabled="@Disabled" Rows="3" MaxLength="@Field.MaxLength"
                                Placeholder="@Field.Placeholder" aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : errorId)" />
                break;
            case "number":
            case "integer":
                <RadzenNumeric TValue="decimal?" Name="@id" Value="@NumberValue" ValueChanged="@(v => SetNumberAsync(v))" Disabled="@Disabled"
                               Step="@(Field.Type == "integer" ? "1" : "any")" Placeholder="@Field.Placeholder" InputAriaLabel="@Field.Label"
                               UpAriaLabel="Artır" DownAriaLabel="Azalt" aria-describedby="@(Error is null ? null : errorId)" />
                break;
            case "date":
            case "datetime":
                <RadzenDatePicker TValue="DateTime?" Name="@id" Value="@DateValue" ValueChanged="@(v => SetDateAsync(v))" Disabled="@Disabled"
                                  ShowTime="@(Field.Type == "datetime")" DateFormat="@(Field.Type == "datetime" ? "dd.MM.yyyy HH:mm" : "dd.MM.yyyy")"
                                  InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Field.Label })" AllowClear="true" />
                break;
            case "select":
                <RadzenDropDown TValue="string" Name="@id" Data="@options" TextProperty="Text" ValueProperty="Key" Value="@SelectedKey"
                                ValueChanged="@(v => SetOptionAsync(v))" Disabled="@Disabled" AllowClear="true" AllowFiltering="@(options.Count > 10)"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="@(Field.Placeholder ?? (loadError ?? "Seçiniz"))"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Field.Label })" />
                break;
            case "picker":
                <div class="middt-ui-picker">
                    <RadzenTextBox id="@id" Value="@(pickerText ?? string.Empty)" ReadOnly="true" Placeholder="@(Field.Placeholder ?? "Seçiniz")" aria-describedby="@(Error is null ? null : errorId)" />
                    <RadzenButton Icon="search" Size="ButtonSize.Small" Click="PickAsync" Disabled="@Disabled" title="Seç" aria-label="@($"{Field.Label} seç")" />
                    @if (Target[Field.Field] is not null && !Disabled)
                    {
                        <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="ClearPickAsync" title="Temizle" aria-label="@($"{Field.Label} temizle")" />
                    }
                </div>
                break;
            default:
                <RadzenTextBox Name="@id" id="@id" Value="@TextValue" ValueChanged="@(v => SetTextAsync(v))" Disabled="@Disabled" MaxLength="@Field.MaxLength"
                               Placeholder="@Field.Placeholder" aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : errorId)" />
                break;
        }
    }
    @if (Error is not null)
    {
        <div id="@errorId" class="middt-ui-input-error" role="alert">@Error</div>
    }
</div>

@code {
    private List<UiOption> options = [];
    private UiField? optionsField;
    private List<JsonObject>? optionsSource;
    private string? pickerText;
    private string? loadError;
    private readonly CancellationTokenSource cancellation = new();

    [Inject]
    private UiLookupCache LookupCache { get; set; } = default!;

    [Inject]
    private UiDataClient DataClient { get; set; } = default!;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Parameter, EditorRequired]
    public UiField Field { get; set; } = default!;

    /// <summary>Object the value is written to (<c>Target[Field.Field]</c>).</summary>
    [Parameter, EditorRequired]
    public JsonObject Target { get; set; } = default!;

    [Parameter, EditorRequired]
    public UiRenderContext Context { get; set; } = default!;

    [Parameter]
    public string IdPrefix { get; set; } = "ui";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    private string? TextValue => Target[Field.Field] is JsonValue v && v.TryGetValue<string>(out var s) ? s : Target[Field.Field]?.ToString();

    private decimal? NumberValue => UiFieldJson.ToDecimal(Target[Field.Field]);

    private bool BoolValue => Target[Field.Field] is JsonValue v && v.TryGetValue<bool>(out var b) && b;

    private DateTime? DateValue =>
        Target[Field.Field] is JsonValue v && v.TryGetValue<string>(out var s) && DateTime.TryParse(s, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var d)
            ? (d.Kind == DateTimeKind.Utc ? d.ToLocalTime() : d)
            : null;

    private string? SelectedKey => Target[Field.Field] is { } node ? UiFieldJson.Key(node) : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Field.Type == "picker" && Target[Field.Field] is null)
        {
            pickerText = null;
        }

        if (Field.Type == "select")
        {
            if (Field.Lookup is { } lookup && Context.Interactive)
            {
                if (optionsSource is null)
                {
                    options = Field.Options;
                }

                try
                {
                    var items = await LookupCache.GetAllAsync(lookup.Entity, cancellation.Token);

                    // Projected (and cloned) once per field and lookup result, not on every parameter update.
                    if (!ReferenceEquals(optionsField, Field) || !ReferenceEquals(optionsSource, items))
                    {
                        options = [.. items.Select(i => new UiOption(i[lookup.ValueField]?.DeepClone(), UiFieldJson.Key(i[lookup.TextField])))];
                        optionsField = Field;
                        optionsSource = items;
                    }

                    loadError = null;
                }
                catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
                {
                    // editor disposed
                }
                catch (Exception ex) when (ex is InvalidOperationException or OperationCanceledException or HttpRequestException)
                {
                    options = Field.Options;
                    optionsField = null;
                    optionsSource = null;
                    loadError = ex is InvalidOperationException ? ex.Message : "Liste yüklenemedi.";
                }
            }
            else
            {
                options = Field.Options;
                optionsField = null;
                optionsSource = null;
            }
        }
        else if (Field.Type == "picker" && Field.Lookup is { } lookup && Target[Field.Field] is { } value && pickerText is null && Context.Interactive)
        {
            // Editing an existing record: show the text of the stored value.
            var response = await DataClient.GetByIdAsync(lookup.Entity, UiFieldJson.Key(value), cancellation.Token);
            pickerText = response.IsSuccess && response.Data is { } item ? UiFieldJson.Key(item[lookup.TextField]) : UiFieldJson.Key(value);
        }
    }

    private Task SetAsync(JsonNode? value)
    {
        if (value is null)
        {
            Target.Remove(Field.Field);
        }
        else
        {
            Target[Field.Field] = value;
        }

        return OnChange.InvokeAsync();
    }

    private Task SetTextAsync(string? value) => SetAsync(string.IsNullOrEmpty(value) ? null : JsonValue.Create(value));

    private Task SetNumberAsync(decimal? value) =>
        SetAsync(value is not { } number ? null
            : Field.Type == "integer" && decimal.Truncate(number) == number ? JsonValue.Create((long)number)
            : JsonValue.Create(number));

    private Task SetDateAsync(DateTime? value) =>
        SetAsync(value is not { } date ? null
            : Field.Type == "date" ? JsonValue.Create(date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))
            : JsonValue.Create(DateTime.SpecifyKind(date, DateTimeKind.Local).ToUniversalTime().ToString("o", CultureInfo.InvariantCulture)));

    private Task SetOptionAsync(string? key) =>
        SetAsync(key is null ? null : options.FirstOrDefault(o => o.Key == key)?.Value?.DeepClone());

    private async Task PickAsync()
    {
        if (Field.Lookup is not { } lookup)
        {
            return;
        }

        var result = await DialogService.OpenAsync<UiPickerDialog>(
            lookup.Title ?? Field.Label,
            new Dictionary<string, object?> { [nameof(UiPickerDialog.Lookup)] = lookup, [nameof(UiPickerDialog.Context)] = Context },
            new DialogOptions { Width = "min(960px, 95vw)", Resizable = true, CloseDialogOnEsc = true });

        if (result is JsonObject row)
        {
            pickerText = UiFieldJson.Key(row[lookup.TextField]);
            await SetAsync(row[lookup.ValueField]?.DeepClone());
        }
    }

    private Task ClearPickAsync()
    {
        pickerText = null;
        return SetAsync(null);
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
