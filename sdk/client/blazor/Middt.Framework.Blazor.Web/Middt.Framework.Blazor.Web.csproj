<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Product>Middt Framework Blazor Web</Product>
    <Description>Blazor Server frontend for Middt applications: BFF cookie authentication (Middt.Framework.Bff), workflow screens, SignalR, and the Blazor renderer and runtime editor of JSON layouts (Ui/).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Middt.Framework.Blazor.Web.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\bff\Middt.Framework.Bff\Middt.Framework.Bff.csproj" />
    <ProjectReference Include="..\..\dotnet\Middt.Framework.Client\Middt.Framework.Client.csproj" />
    <ProjectReference Include="..\..\..\server\Middt.Framework.Common\Middt.Framework.Common.csproj" />
    <ProjectReference Include="..\..\..\shared\Middt.Framework.Ui.Abstractions\Middt.Framework.Ui.Abstractions.csproj" />
  </ItemGroup>

</Project>
