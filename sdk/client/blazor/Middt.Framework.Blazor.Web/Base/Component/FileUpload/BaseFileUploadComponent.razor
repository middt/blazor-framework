@inherits Middt.Framework.Blazor.Web.Base.BaseComponent

@using Microsoft.AspNetCore.Components.Forms
@using Middt.Framework.Blazor.Web.Model

<div class="middt-file-upload rz-mb-3">
    <InputFile OnChange="HandleInputFileChange"
               accept="@AcceptedFileTypes"
               multiple="@(MaxFileCount > 1)"
               class="form-control" />
</div>

@if (ActiveFileUploadModelList.Count > 0)
{
    <RadzenDataGrid Data="ActiveFileUploadModelList" TItem="FileUploadModel">
        <Columns>
            <RadzenDataGridColumn TItem="FileUploadModel" Title="DOSYA ADI" Width="80%">
                <Template Context="file">
                    @if (!string.IsNullOrEmpty(file.FilePath))
                    {
                        <a href="@file.FilePath" target="_blank" download>@file.Name</a>
                    }
                    else
                    {
                        @file.Name
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FileUploadModel">
                <Template Context="file">
                    <RadzenButton Click="() => Delete(file)" Icon="delete" ButtonStyle="ButtonStyle.Danger" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
