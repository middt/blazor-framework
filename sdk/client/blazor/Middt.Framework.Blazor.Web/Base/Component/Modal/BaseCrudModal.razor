@inherits Middt.Framework.Blazor.Web.Base.Component.Modal.BaseModalCode

<BaseModal Title="@Title" @ref="BaseModalRef" IsFullScreen="@IsFullScreen" Width="@Width" Height="@Height" ModalName="Crud" ShowClose="@ShowClose" OnClose="HandleClosed">
    <ChildContent>
        @if (Model is not null)
        {
            <EditForm Model="@Model" OnValidSubmit="@Save">
                <DataAnnotationsValidator />
                @ChildContent

                <div class="row top-space">
                    <div class="col-md-12">
                        <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Kaydet" />
                        <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="İptal" Click="Close" />
                    </div>
                </div>
            </EditForm>
        }
        @FooterContent
    </ChildContent>
</BaseModal>
