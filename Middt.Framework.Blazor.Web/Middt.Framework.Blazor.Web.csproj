<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Product>Middt Framework Blazor Web</Product>
    <Description>Blazor Server building blocks for Middt applications: generic list/detail/CRUD pages, modals, authorization, SignalR and file upload components.</Description>
    <IsPackable>true</IsPackable>
    <!-- Ships Razor Pages (Account/Login, Account/Logout) next to the Blazor components. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" />
    <PackageReference Include="Syncfusion.Blazor.Themes" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Middt.Framework.Blazor.Web.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Middt.Framework.Common\Middt.Framework.Common.csproj" />
  </ItemGroup>

</Project>
