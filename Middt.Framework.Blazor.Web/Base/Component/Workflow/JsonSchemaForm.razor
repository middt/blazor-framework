@namespace Middt.Framework.Blazor.Web.Base.Component.Workflow

<div class="middt-jsf">
    @if (fields.Count == 0)
    {
        @if (!string.IsNullOrEmpty(EmptyText))
        {
            <p class="middt-jsf-empty">@EmptyText</p>
        }
    }
    @foreach (var field in fields)
    {
        var id = FieldId(field);
        var errorId = $"{id}-error";
        <div class="middt-jsf-field @(field.Error is null ? null : "middt-jsf-invalid")">
            @if (field.Kind == FieldKind.Boolean)
            {
                <div class="middt-jsf-check">
                    <RadzenCheckBox TValue="bool" Name="@id" InputAttributes="@AriaLabel(field)" Value="@field.BoolValue" Disabled="@Disabled"
                                    ValueChanged="@(v => OnFieldChanged(field, () => field.BoolValue = v))" />
                    <label for="@id" class="middt-jsf-label">@field.Title</label>
                </div>
            }
            else
            {
                <label for="@id" class="middt-jsf-label">
                    @field.Title
                    @if (field.Required)
                    {
                        <span class="middt-jsf-required" title="Zorunlu alan">*</span>
                    }
                </label>
                @switch (field.Kind)
                {
                    case FieldKind.LongText:
                        <RadzenTextArea Name="@id" id="@id" Value="@field.TextValue" Disabled="@Disabled" Rows="3" MaxLength="@field.MaxLength"
                                        aria-required="@(field.Required ? "true" : null)" aria-invalid="@(field.Error is null ? null : "true")" aria-describedby="@(field.Error is null ? null : errorId)"
                                        ValueChanged="@(v => OnFieldChanged(field, () => field.TextValue = v))" class="middt-jsf-input" />
                        break;
                    case FieldKind.Json:
                        <RadzenTextArea Name="@id" id="@id" Value="@field.TextValue" Disabled="@Disabled" Rows="4" Placeholder="JSON"
                                        aria-required="@(field.Required ? "true" : null)" aria-invalid="@(field.Error is null ? null : "true")" aria-describedby="@(field.Error is null ? null : errorId)"
                                        ValueChanged="@(v => OnFieldChanged(field, () => field.TextValue = v))" class="middt-jsf-input middt-jsf-code" />
                        break;
                    case FieldKind.Enum:
                        <RadzenDropDown TValue="string" Name="@id" InputAttributes="@AriaLabel(field)" Data="@field.EnumValues" Value="@field.TextValue" Disabled="@Disabled"
                                        AllowClear="@(!field.Required)" Placeholder="Seçiniz"
                                        aria-describedby="@(field.Error is null ? null : errorId)"
                                        ValueChanged="@(v => OnFieldChanged(field, () => field.TextValue = v))" class="middt-jsf-input" />
                        break;
                    case FieldKind.DateTime:
                    case FieldKind.Date:
                        <RadzenDatePicker TValue="DateTime?" Name="@id" InputAttributes="@AriaLabel(field)" Value="@field.DateValue" Disabled="@Disabled"
                                          ShowTime="@(field.Kind == FieldKind.DateTime)" DateFormat="@(field.Kind == FieldKind.DateTime ? "dd.MM.yyyy HH:mm" : "dd.MM.yyyy")"
                                          aria-describedby="@(field.Error is null ? null : errorId)"
                                          ValueChanged="@(v => OnFieldChanged(field, () => field.DateValue = v))" class="middt-jsf-input" />
                        break;
                    case FieldKind.Number:
                    case FieldKind.Integer:
                        <RadzenNumeric TValue="decimal?" Name="@id" InputAriaLabel="@field.Title" UpAriaLabel="Artır" DownAriaLabel="Azalt" Value="@field.NumberValue" Disabled="@Disabled"
                                       Step="@(field.Kind == FieldKind.Integer ? "1" : "any")"
                                       aria-describedby="@(field.Error is null ? null : errorId)"
                                       ValueChanged="@(v => OnFieldChanged(field, () => field.NumberValue = v))" class="middt-jsf-input" />
                        break;
                    default:
                        <RadzenTextBox Name="@id" id="@id" Value="@field.TextValue" Disabled="@Disabled" MaxLength="@field.MaxLength"
                                       aria-required="@(field.Required ? "true" : null)" aria-invalid="@(field.Error is null ? null : "true")" aria-describedby="@(field.Error is null ? null : errorId)"
                                       ValueChanged="@(v => OnFieldChanged(field, () => field.TextValue = v))" class="middt-jsf-input" />
                        break;
                }
            }
            @if (!string.IsNullOrEmpty(field.Description))
            {
                <small class="middt-jsf-help">@field.Description</small>
            }
            @if (field.Error is not null)
            {
                <div id="@errorId" class="middt-jsf-error" role="alert">@field.Error</div>
            }
        </div>
    }
</div>
