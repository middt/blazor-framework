@typeparam TService where TService : ICrudApiClient<TModel>
@typeparam TModel where TModel : BaseRequestModel, new()
@inherits BaseDetailCrudPageComponentClass<TService, TModel>

@if (Model is not null)
{
    <EditForm Model="@Model" OnValidSubmit="@SaveButtonClick">
        <DataAnnotationsValidator />
        @DetailContent
    </EditForm>
}
<BaseLoadingModal @ref="LoadingModal" />
