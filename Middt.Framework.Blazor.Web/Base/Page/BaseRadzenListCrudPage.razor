@typeparam TService where TService : ICrudApiClient<TModel>
@typeparam TModel where TModel : BaseRequestModel, new()
@inherits BaseListCrudPageComponentClass<TService, TModel>

@if (SearchContent is not null && !HideSearch)
{
    <RadzenCard class="rz-mb-4">
        <EditForm Model="@SearchRequestModel" OnSubmit="SearchButton">
            <div class="row" style="margin-top:10px;">
                @SearchContent
            </div>
            @if (!HideSearchButton)
            {
                <div class="row" style="margin-top:10px;">
                    <div class="col-lg-5">
                        <RadzenButton ButtonType="ButtonType.Submit" Icon="search" Text="Ara" />
                        <RadzenButton Icon="search_off" Text="İptal" ButtonStyle="ButtonStyle.Light" Click="Cancel" />
                    </div>
                </div>
            }
        </EditForm>
    </RadzenCard>
}

@if (!HideInsertButton)
{
    <RadzenButton Icon="add_circle_outline" class="rz-mb-2" Text="@InsertText" Click="New" />
}

<RadzenDataGrid @ref="DataGrid"
                TItem="TModel"
                Data="@SearchResultModel.Data"
                Count="@SearchResultModel.Count"
                LoadData="OnGridLoadData"
                IsLoading="@IsSearching"
                AllowPaging="true"
                AllowSorting="true"
                AllowColumnResize="true"
                PageSize="@PageSize"
                PageSizeOptions="@(new[] { 10, 20, 50, 100 })"
                ShowPagingSummary="true"
                Template="@TemplateContent"
                Style="min-height: 300px">
    <Columns>
        @ListContent
    </Columns>
</RadzenDataGrid>

<BaseCrudModal Title="@ModalTitle" @ref="CrudModal" IsFullScreen="@IsModalFullScreen" Width="@ModalWidth" Height="@ModalHeight"
               OnSave="SaveButtonClick" OnClose="_ => CloseButtonClick()">
    <ChildContent>
        @EditContent
    </ChildContent>
</BaseCrudModal>
<BaseLoadingModal @ref="LoadingModal" />
