# Copy to .env (git ignored) for `docker compose up`. Never commit real values.
# Generate e.g. with: openssl rand -hex 32
# Client secrets of the two demo BFFs at the identity provider (middt-sample-identity). The IdP stores them on first
# start; afterwards changing them here also requires changing them in http://localhost:8083/admin/clients.
IDP_BLAZOR_CLIENT_SECRET=
IDP_ANGULAR_CLIENT_SECRET=
# SQL Server requires 8+ characters with upper/lower case, digits and symbols.
MSSQL_SA_PASSWORD=
# RabbitMQ account created on the broker's first start (also used by the API's messaging connection string).
# Use URL-safe characters only (it is embedded in an amqp:// URI).
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
