# Copy to .env (git ignored) for `docker compose up`. Never commit real values.
# Generate e.g. with: openssl rand -hex 32
# Client secrets of the two demo BFFs at the identity provider (middt-sample-identity). The IdP stores them on first
# start; afterwards changing them here also requires changing them in http://localhost:8083/admin/clients.
IDP_BLAZOR_CLIENT_SECRET=
IDP_ANGULAR_CLIENT_SECRET=
# PostgreSQL superuser password for db_server.
POSTGRES_PASSWORD=
# RabbitMQ account created on the broker's first start (also used by the API's messaging connection string).
# Use URL-safe characters only (it is embedded in an amqp:// URI).
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# OpenObserve container root credentials (defaults to admin@middt.local / Complexpass#123 in docker-compose.yml).
OPENOBSERVE_USER=admin@middt.local
OPENOBSERVE_PASSWORD=Complexpass#123
# Standard OpenTelemetry OTLP exporter settings (defaults to OpenObserve in docker-compose.yml, but can point to
# OpenTelemetry Collector, Jaeger, Elastic APM, Grafana Tempo, Seq, etc.).
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YWRtaW5AbWlkZHQubG9jYWw6Q29tcGxleHBhc3MjMTIz,stream-name=default

