    <Description>Inheritance-based RabbitMQ producer/consumer base classes (RabbitMQ.Client 7, fully async) for Middt applications.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
