  <ItemGroup>
    <ProjectReference Include="..\Middt.Framework.Common\Middt.Framework.Common.csproj" />
    <ProjectReference Include="..\Middt.Framework.Model\Middt.Framework.Model.csproj" />
  </ItemGroup>

</Project>
