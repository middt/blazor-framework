@page "/Bike/CategoryProduct"
@inherits BaseDetailPageCode<CategoryService, Category>

<BaseDetailPage TService="CategoryService" TModel="Category" QueryStringID="ID" @ref="baseDetailPage">
    <DetailContent>
        <RadzenCard class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H5">@Model.CategoryName</RadzenText>
        </RadzenCard>
    </DetailContent>
</BaseDetailPage>

<BaseRadzenListPage TService="ProductService" TModel="Product" IsFirstLoad="false" @ref="productListPage">
    <ListContent>
        <RadzenDataGridColumn TItem="Product" Property="ProductName" Title="Name" />
        <RadzenDataGridColumn TItem="Product" Property="ModelYear" Title="Year" />
        <RadzenDataGridColumn TItem="Product" Property="ListPrice" Title="Price" FormatString="{0:N2}" />
    </ListContent>
</BaseRadzenListPage>
