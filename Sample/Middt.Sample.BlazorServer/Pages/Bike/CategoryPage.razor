@page "/Bike/Category"
@inherits BaseListCrudPageCode<CategoryService, Category>

<BaseRadzenListCrudPage ModalTitle="Category" TService="CategoryService" TModel="Category" @ref="baseListCrudPage">
    <SearchContent>
        <div class="row top-space" style="width:100%;">
            <div class="col-md-2">Name</div>
            <div class="col-md-4">
                <RadzenTextBox @bind-Value="SearchRequestModel.RequestModel.CategoryName" Style="width:250px" />
            </div>
        </div>
    </SearchContent>
    <ListContent>
        <RadzenDataGridColumn TItem="Category" Property="CategoryName" Title="Name" />
        <RadzenDataGridColumn TItem="Category" Width="160px" Sortable="false">
            <Template Context="item">
                <RadzenButton Click="() => Detail(item)" Icon="search" Size="ButtonSize.Small" />
                <RadzenButton Click="() => Edit(item)" Icon="edit" Size="ButtonSize.Small" />
                <RadzenButton Click="() => Delete(item)" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" />
            </Template>
        </RadzenDataGridColumn>
    </ListContent>
    <EditContent>
        <div class="row top-space">
            <div class="align-items-center d-flex col-md-3">
                <label for="categoryName">Name</label>
            </div>
            <div class="col-md-9">
                <RadzenTextBox id="categoryName" @bind-Value="Model.CategoryName" class="w-100" />
                <ValidationMessage For="() => Model.CategoryName" />
            </div>
        </div>
    </EditContent>
</BaseRadzenListCrudPage>
