@inherits BaseModalCode

<BaseModal Title="@Title" @ref="baseModal" IsFullScreen="true" OnClose="HandleClosed">
    <ChildContent>
        <BaseRadzenListPage TService="CustomerService" TModel="Customer" @ref="customerListPage">
            <SearchContent>
                <div class="row top-space" style="width:100%;">
                    <div class="col-md-2">First Name</div>
                    <div class="col-md-4">
                        <RadzenTextBox @bind-Value="customerListPage.SearchRequestModel.RequestModel.FirstName" Style="width:250px" />
                    </div>
                    <div class="col-md-2">Last Name</div>
                    <div class="col-md-4">
                        <RadzenTextBox @bind-Value="customerListPage.SearchRequestModel.RequestModel.LastName" Style="width:250px" />
                    </div>
                </div>
            </SearchContent>
            <ListContent>
                <RadzenDataGridColumn TItem="Customer" Property="FirstName" Title="First Name" />
                <RadzenDataGridColumn TItem="Customer" Property="LastName" Title="Last Name" />
                <RadzenDataGridColumn TItem="Customer" Width="70px" Sortable="false">
                    <Template Context="item">
                        <RadzenButton Click="() => Select(item)" Icon="check" Size="ButtonSize.Small" />
                    </Template>
                </RadzenDataGridColumn>
            </ListContent>
        </BaseRadzenListPage>

        <div class="row top-space">
            <div class="col-md-12">
                <RadzenButton ButtonStyle="ButtonStyle.Secondary" Text="İptal" Click="Close" />
            </div>
        </div>
    </ChildContent>
</BaseModal>
