@page "/Workflow/OrderApproval"
@using Middt.Framework.Blazor.Web.Base.Component.Workflow
@using Middt.Framework.Model.Workflow

<div class="middt-wf-layout">
    <WorkflowInstanceList @ref="list" Workflow="@WorkflowKey" Title="Sipariş onayları" SelectedId="@selectedId" OnSelected="OnSelected" />
    <WorkflowInstanceDetail Workflow="@WorkflowKey" InstanceId="@selectedId" OnChanged="OnChanged" />
</div>

@code {
    private const string WorkflowKey = "order-approval";
    private WorkflowInstanceList? list;
    private Guid? selectedId;

    private void OnSelected(WorkflowInstanceModel instance) => selectedId = instance.Id;

    // A transition changes state/status in the list as well.
    private Task OnChanged(WorkflowInstanceModel instance) => list?.RefreshAsync() ?? Task.CompletedTask;
}
