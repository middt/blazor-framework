{
  // Order approval: credit check (subflow) → routing by amount → manager review (escalates after 2 minutes) → approved/rejected.
  "key": "order-approval",
  "version": 1,
  "title": "Sipariş onayı",
  "timeout": { "after": "P7D", "target": "expired" },
  "start": {
    "key": "start",
    "target": "credit-check",
    "input": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "orderId", "customerName", "amount" ],
        "properties": {
          "orderId": { "type": "integer", "minimum": 1, "title": "Sipariş no" },
          "customerName": { "type": "string", "minLength": 2, "maxLength": 100, "title": "Müşteri" },
          "amount": { "type": "number", "minimum": 0, "title": "Tutar" },
          "note": { "type": "string", "maxLength": 500, "title": "Not" }
        }
      },
      "set": { "requestedBy": "user.Name", "requestedAt": "now" }
    }
  },
  "states": [
    {
      "key": "credit-check",
      "title": "Kredi kontrolü",
      "type": "SubFlow",
      "subFlow": {
        "workflow": "credit-check",
        "input": { "customerName": "data.customerName", "amount": "data.amount" },
        "outputInto": "credit"
      },
      "transitions": [
        { "key": "credit-ok", "target": "routing", "trigger": "Automatic", "rule": "child.subType == \"Success\"" },
        { "key": "credit-declined", "target": "rejected", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "routing",
      "title": "Yönlendirme",
      "transitions": [
        { "key": "needs-review", "target": "manager-review", "trigger": "Automatic", "rule": "data.amount > 5000" },
        { "key": "auto-approve", "target": "approved", "trigger": "Automatic", "default": true }
      ]
    },
    {
      "key": "manager-review",
      "title": "Yönetici onayı",
      "subType": "Human",
      "transitions": [
        {
          "key": "approve", "title": "Onayla", "target": "approved", "roles": [ "manager" ],
          "input": {
            "schema": { "type": "object", "additionalProperties": false, "properties": { "comment": { "type": "string", "maxLength": 500, "title": "Açıklama" } } },
            "into": "review",
            "set": { "review.approvedBy": "user.Name", "review.decidedAt": "now" }
          }
        },
        {
          "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ],
          "input": {
            "schema": { "type": "object", "additionalProperties": false, "required": [ "reason" ], "properties": { "reason": { "type": "string", "minLength": 3, "maxLength": 500, "title": "Red nedeni" } } },
            "into": "review",
            "set": { "review.rejectedBy": "user.Name", "review.decidedAt": "now" }
          }
        },
        { "key": "escalate", "target": "escalated", "trigger": "Scheduled", "after": "00:02:00" }
      ]
    },
    {
      "key": "escalated",
      "title": "Eskale edildi",
      "subType": "Human",
      "onEntry": [ { "task": "log", "config": { "message": "Order {{ data.orderId }} escalated: no decision within 2 minutes", "level": "Warning" } } ],
      "transitions": [
        { "key": "approve", "title": "Onayla", "target": "approved", "roles": [ "manager" ] },
        { "key": "reject", "title": "Reddet", "target": "rejected", "roles": [ "manager" ] }
      ]
    },
    {
      "key": "approved",
      "title": "Onaylandı",
      "type": "Finish",
      "subType": "Success",
      "onEntry": [
        { "task": "set", "config": { "values": { "approvedAt": "now" } } },
        {
          "task": "publish",
          "key": "notify-approved",
          "config": { "type": "OrderApproved", "payload": { "orderId": "{{ data.orderId }}", "amount": "{{ data.amount }}", "customer": "{{ data.customerName }}" } },
          "onError": { "maxAttempts": 3, "delay": "00:00:01", "action": "Continue" }
        }
      ]
    },
    { "key": "rejected", "title": "Reddedildi", "type": "Finish", "subType": "Error",
      "onEntry": [ { "task": "log", "config": { "message": "Order {{ data.orderId }} rejected" } } ] },
    { "key": "cancelled", "title": "İptal edildi", "type": "Finish", "subType": "Cancelled" },
    { "key": "expired", "title": "Süresi doldu", "type": "Finish", "subType": "Timeout" }
  ],
  "sharedTransitions": [
    {
      "key": "cancel", "title": "İptal et", "target": "cancelled", "availableIn": [ "*" ],
      "input": {
        "schema": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string", "maxLength": 500, "title": "İptal nedeni" } } },
        "into": "cancellation",
        "set": { "cancellation.by": "user.Name" }
      }
    }
  ]
}
